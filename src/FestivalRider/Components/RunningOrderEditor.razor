@using FestivalRider.Models
@using FestivalRider.Services
@using Microsoft.AspNetCore.Components.Web

<style>
    .fr-inline-edit {
        border: none;
        background: transparent;
        outline: none;
        padding: 0;
        margin: 0;
        font-size: 13px;
        line-height: 1;
        height: 13px;
        text-align: center;
        min-width: 36px;
        width: auto;
        color: inherit;
        font-weight: 700;
        -webkit-appearance: none;
        -moz-appearance: textfield;
        appearance: none;
        box-sizing: content-box;
    }
    /* Time picker indicator is now visible for easier editing */
    .fr-inline-edit::-webkit-inner-spin-button,
    .fr-inline-edit::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
    .fr-inline-edit::-webkit-datetime-edit { padding: 0; }
    .fr-inline-edit::-webkit-datetime-edit-fields-wrapper { padding: 0; }
    .fr-inline-edit[type="time"] { min-width: 48px; }
</style>

<div class="card mb-3 shadow-sm">
    <div class="card-header d-flex align-items-center gap-3 py-2" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing:.05em;">@DayNumberLabel</span>
            <input type="number" min="1" max="@ShowDayCount"
                   class="form-control form-control-sm fw-bold text-center border-0 bg-white shadow-sm"
                   style="width: 60px; font-size: 1.1rem; border-radius: 8px;"
                   value="@Order.ShowDayNumber"
                   @onchange="OnDayChanged" />
        </div>
        <div class="ms-auto d-flex gap-1">
            <button class="btn btn-sm btn-primary px-3" @onclick="Notify">@UpdateBtnLabel</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showScheduleOptions = true">@ScheduleOptionsBtnLabel</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showVenueOptions = true">@VenueOptionsBtnLabel</button>
            @if (OnDeleteRequest.HasDelegate)
            {
                <button class="btn btn-sm btn-outline-danger" @onclick="() => OnDeleteRequest.InvokeAsync()">@DeleteBtnLabel</button>
            }
        </div>
    </div>
    
    @* Running Order Timings *@
    <div class="card-body py-2 px-3 d-flex flex-column gap-2">

        @* ── Row 1: Venue bounds + curfews ── *@
        <div class="d-flex flex-wrap gap-2 align-items-center border-start border-3 ps-2" style="border-color: #198754 !important;">
            <TimeChipControl Icon="🟢" Label="@VenueOpenLabel" Value="@(Order.VenueOpenTimeOverride ?? Show.VenueOpenTime)" BgColor="#d1e7dd" BaseDate="BaseDate" OnChange="v => { Order.VenueOpenTimeOverride = v; Notify(); }" />
            <TimeChipControl Icon="🔴" Label="@VenueCloseLabel" Value="@(Order.VenueCloseTimeOverride ?? Show.VenueCloseTime)" BgColor="#f8d7da" BaseDate="BaseDate" OnChange="v => { Order.VenueCloseTimeOverride = v; Notify(); }" />
            <span class="text-muted" style="font-size:10px;">│</span>
            <TimeChipControl Icon="🔇" Label="@SoundCurfewLabel" Value="@(Order.SoundCurfewTimeOverride ?? Show.SoundCurfewTime)" BgColor="#f8d7da" BaseDate="BaseDate" OnChange="v => { Order.SoundCurfewTimeOverride = v; Notify(); }" />
            <TimeChipControl Icon="🚫" Label="@BackstageCurfewLabel" Value="@(Order.BackstageCurfewTimeOverride ?? Show.BackstageCurfewTime)" BgColor="#f8d7da" BaseDate="BaseDate" OnChange="v => { Order.BackstageCurfewTimeOverride = v; Notify(); }" />
        </div>

        @* ── Row 2: Schedule anchors + timing scalars ── *@
        <div class="d-flex flex-wrap gap-2 align-items-center border-start border-3 ps-2" style="border-color: #0d6efd !important;">
            <TimeChipControl Icon="🔧" Label="@TechnicalGetInLabel" Value="@(Order.TechnicalGetInTimeOverride ?? Show.TechnicalGetInTime)" BgColor="#cfe2ff" BaseDate="BaseDate" OnChange="v => { Order.TechnicalGetInTimeOverride = v; Notify(); }" />
            <TimeChipControl Icon="🚪" Label="@DoorsLabel" Value="@(Order.DoorsOpeningTimeOverride ?? Show.DoorsOpeningTime)" BgColor="#cfe2ff" BaseDate="BaseDate" OnChange="v => { Order.DoorsOpeningTimeOverride = v; Notify(); }" />
            <TimeChipControl Icon="🎤" Label="@FirstShowLabel" Value="@(Order.FirstShowTimeOverride ?? Show.FirstShowTime)" BgColor="#cfe2ff" BaseDate="BaseDate" OnChange="v => { Order.FirstShowTimeOverride = v; Notify(); }" />
            <span class="text-muted" style="font-size:10px;">│</span>
            <span class="d-inline-flex align-items-center gap-1 rounded-pill border px-2 py-1" style="background:#e7f1ff; border-color:#9ec5fe !important; font-size:13px; white-space:nowrap;">
                <span>⏱</span>
                <span class="text-muted fw-semibold">@BreakLabel</span>
                <span style="width:4px;"></span>
                @if (_editingBreak)
                {
                    <input type="number" class="fr-inline-edit"
                           @ref="_breakInputRef"
                           @bind="_breakEditValue"
                           @bind:after="SaveBreakAndClear"
                           @onblur="SaveBreakAndClear"
                           @onkeydown="HandleBreakKeyDown" />
                }
                else
                {
                    <span class="fw-bold text-dark" style="min-width:36px; text-align:center; cursor:pointer; line-height:1;" @onclick="StartEditingBreak">@(Order.BreakTimeMinutesOverride?.ToString() ?? "—")</span>
                }
                <button type="button" class="btn btn-link p-0 text-muted lh-1" style="font-size:13px; text-decoration:none; min-width:16px;"
                        @onclick="() => OnOverrideInt((Order.BreakTimeMinutesOverride ?? Show.BreakTimeMinutes) - 5, v => Order.BreakTimeMinutesOverride = v)">−</button>
                <button type="button" class="btn btn-link p-0 text-muted lh-1" style="font-size:13px; text-decoration:none; min-width:16px;"
                        @onclick="() => OnOverrideInt((Order.BreakTimeMinutesOverride ?? Show.BreakTimeMinutes) + 5, v => Order.BreakTimeMinutesOverride = v)">+</button>
                <span class="text-muted" style="font-size:11px;">min</span>
            </span>
            <span class="d-inline-flex align-items-center gap-1 rounded-pill border px-2 py-1" style="background:#e7f1ff; border-color:#9ec5fe !important; font-size:13px; white-space:nowrap;">
                <span>↔</span>
                <span class="text-muted fw-semibold">@GapLabel</span>
                <span style="width:4px;"></span>
                @if (_editingGap)
                {
                    <input type="number" class="fr-inline-edit"
                           @ref="_gapInputRef"
                           @bind="_gapEditValue"
                           @bind:after="SaveGapAndClear"
                           @onblur="SaveGapAndClear"
                           @onkeydown="HandleGapKeyDown" />
                }
                else
                {
                    <span class="fw-bold text-dark" style="min-width:36px; text-align:center; cursor:pointer; line-height:1;" @onclick="StartEditingGap">@(Order.SoundcheckGapMinutesOverride?.ToString() ?? "—")</span>
                }
                <button type="button" class="btn btn-link p-0 text-muted lh-1" style="font-size:13px; text-decoration:none; min-width:16px;"
                        @onclick="() => OnOverrideInt((Order.SoundcheckGapMinutesOverride ?? Show.SoundcheckGapMinutes) - 5, v => Order.SoundcheckGapMinutesOverride = v)">−</button>
                <button type="button" class="btn btn-link p-0 text-muted lh-1" style="font-size:13px; text-decoration:none; min-width:16px;"
                        @onclick="() => OnOverrideInt((Order.SoundcheckGapMinutesOverride ?? Show.SoundcheckGapMinutes) + 5, v => Order.SoundcheckGapMinutesOverride = v)">+</button>
                <span class="text-muted" style="font-size:11px;">min</span>
            </span>
        </div>

        @* ── Row 3: Catering ── *@
        <div class="d-flex flex-wrap gap-2 align-items-center border-start border-3 ps-2" style="border-color: #6f42c1 !important;">
            <TimeChipControl Icon="🍳" Label="@BreakfastLabel" Value="@(Order.BreakfastHoursOverride?.Start ?? Show.BreakfastHours?.Start)" BgColor="#e8d5f5" BaseDate="BaseDate" OnChange="v => { Order.BreakfastHoursOverride ??= new TimeSlot(); Order.BreakfastHoursOverride.Start = v ?? BaseDate; Notify(); }" />
            <TimeChipControl Icon="🥗" Label="@LunchLabel" Value="@(Order.LunchHoursOverride?.Start ?? Show.LunchHours?.Start)" BgColor="#e8d5f5" BaseDate="BaseDate" OnChange="v => { Order.LunchHoursOverride ??= new TimeSlot(); Order.LunchHoursOverride.Start = v ?? BaseDate; Notify(); }" />
            <TimeChipControl Icon="🍽" Label="@DinnerLabel" Value="@(Order.DinnerHoursOverride?.Start ?? Show.DinnerHours?.Start)" BgColor="#e8d5f5" BaseDate="BaseDate" OnChange="v => { Order.DinnerHoursOverride ??= new TimeSlot(); Order.DinnerHoursOverride.Start = v ?? BaseDate; Notify(); }" />
        </div>

    </div>
</div>

<div class="row g-2">
    <div class="col-lg-8">
        <ScheduleGantt Order="Order" Show="Show" SelectedSlotId="_selectedSlotId" Bands="Bands" Stages="Stages"
                       SelectSlotHint="@SelectSlotHint"
                       UnknownBandLabel="@UnknownBandLabel"
                       GetEventLabel="GetEventLabel"
                       OnSelectSlot="OnSelectSlot"
                       OnMoveSlotUp="MoveSlotUp"
                       OnMoveSlotDown="MoveSlotDown"
                       OnRemoveSlot="RemoveSlot" />

        @if (CanAddSlot)
        {
            <div class="d-flex gap-2 align-items-end mt-2">
                <select class="form-select form-select-sm" style="width: 200px;" @bind="_newSlotBandId">
                    <option value="@Guid.Empty">@PickBandLabel</option>
                    @foreach (var b in Bands)
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                </select>
                <select class="form-select form-select-sm" style="width: 150px;" @bind="_newSlotStageId">
                    <option value="0">@PickStageLabel</option>
                    @foreach (var s in Stages)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
                <button class="btn btn-sm btn-outline-primary" @onclick="AddSlot">@AddSlotLabel</button>
            </div>
        }
    </div>
    <div class="col-lg-4">
        <ScheduleBandPanel Slot="SelectedSlot" Order="Order" Show="Show" BandName="@SelectedBandName" StageName="@SelectedStageName"
                             GetEventLabel="GetEventLabel"
                             EarlyChainHeading="@EarlyChainHeading"
                             PreShowHeading="@PreShowHeading"
                             PostShowHeading="@PostShowHeading"
                             BackstageRowLabel="@BackstageRowLabel"
                             ConstraintsHeading="@ConstraintsHeading"
                             BackstageCurfewLabel="@BackstageCurfewLabel"
                             HasPersonalCurfewLabel="@HasPersonalCurfewLabel"
                             CateringLabel="@CateringLabel"
                             StartLabel="@StartLabel"
                             EndLabel="@EndLabel"
                             OverrideFlagsHeading="@OverrideFlagsHeading"
                             AllowSoundcheckOverlapLabel="@AllowSoundcheckOverlapLabel"
                             AllowOnStageOverlapLabel="@AllowOnStageOverlapLabel"
                             AddEventBtn="@AddEventBtn"
                             AddEventPickerTitle="@AddEventPickerTitle"
                             AddEventPlacementHint="@AddEventPlacementHint"
                             OnChange="Notify"
                             OnAddEvent="OnAddEvent" />
    </div>
</div>

<ScheduleOptionsModal @bind-Visible="_showScheduleOptions" Order="Order" Show="Show" OnChange="Notify"
                      Title="@ScheduleOptionsTitle"
                      ModeLabel="@ModeLabel"
                      AnchorLabel="@AnchorLabel"
                      DefaultLabel="@DefaultLabel"
                      TemplateHeading="@TemplateTitle"
                      DefaultSetLengthLabel="@DefaultSetLengthLabel"
                      PresetFestivalMainStage="@PresetFestivalMainStage"
                      PresetFestivalTent="@PresetFestivalTent"
                      PresetTraditionalVenue="@PresetTraditionalVenue"
                      CloseLabel="@CloseLabel"
                      CancelLabel="@CancelLabel"
                      ModeChangeConfirmTitle="@ModeChangeConfirmTitle"
                      ModeChangeConfirmMessage="@ModeChangeConfirmMessage"
                      ModeChangeConfirmLabel="@ModeChangeConfirmLabel"
                      GetModeLabel="GetModeLabel"
                      GetEventLabel="GetEventLabel" />

<VenueOptionsEditor @bind-Visible="_showVenueOptions" Options="GetOrCreateVenueOptions()" OnChange="Notify"
                  Order="Order" Show="Show"
                  GetModeLabel="GetModeLabel" GetEventLabel="GetEventLabel"
                  Title="@VenueOptionsTitle"
                  RunningOrderOptionsHeading="@RunningOrderOptionsHeading"
                  ModeLabel="@ModeLabel"
                  AnchorLabel="@AnchorLabel"
                  DefaultLabel="@DefaultLabel"
                  CloseLabel="@CloseLabel"
                  GetInLabel="@VenueGetInLabel"
                  LoadInVenueLabel="@VenueLoadInVenueLabel"
                  StageLoadInLabel="@VenueStageLoadInLabel"
                  BackstageDropLabel="@VenueBackstageDropLabel"
                  SetupOnStageLabel="@VenueSetupOnStageLabel"
                  SoundcheckLabel="@VenueSoundcheckLabel"
                  PreShowLinecheckLabel="@VenuePreShowLinecheckLabel"
                  BackstageLeadLabel="@VenueBackstageLeadLabel"
                  ChangeoverLabel="@VenueChangeoverLabel"
                  SetLengthLabel="@VenueSetLengthLabel" />

@code {
    [Parameter] public RunningOrder Order { get; set; } = new();
    [Parameter] public ShowData Show { get; set; } = new();
    [Parameter] public IReadOnlyList<Band> Bands { get; set; } = new List<Band>();
    [Parameter] public IReadOnlyList<Stage> Stages { get; set; } = new List<Stage>();
    [Parameter] public Func<TimingEventType, string> GetEventLabel { get; set; } = t => t.ToString();
    [Parameter] public Func<ScheduleMode, string> GetModeLabel { get; set; } = m => m.ToString();
    [Parameter] public EventCallback OnChange { get; set; }

    [Parameter] public string DayNumberLabel { get; set; } = "Day";
    [Parameter] public int ShowDayCount { get; set; } = 31;
    [Parameter] public string DeleteBtnLabel { get; set; } = "Delete";
    [Parameter] public EventCallback<ChangeEventArgs> OnDayChanged { get; set; }
    [Parameter] public EventCallback OnDeleteRequest { get; set; }
    [Parameter] public string ModeLabel { get; set; } = "Mode";
    [Parameter] public string AnchorLabel { get; set; } = "Anchor";
    [Parameter] public string DefaultLabel { get; set; } = "Default";
    [Parameter] public string BreakLabel { get; set; } = "Break";
    [Parameter] public string GapLabel { get; set; } = "Gap";
    [Parameter] public string VenueOpenLabel { get; set; } = "Venue open";
    [Parameter] public string VenueCloseLabel { get; set; } = "Venue close";
    [Parameter] public string TechnicalGetInLabel { get; set; } = "Tech get-in";
    [Parameter] public string DoorsLabel { get; set; } = "Doors";
    [Parameter] public string FirstShowLabel { get; set; } = "First show";
    [Parameter] public string SoundCurfewLabel { get; set; } = "Sound curfew";
    [Parameter] public string BackstageCurfewLabel { get; set; } = "Backstage curfew";
    [Parameter] public string BreakfastLabel { get; set; } = "Breakfast";
    [Parameter] public string LunchLabel { get; set; } = "Lunch";
    [Parameter] public string DinnerLabel { get; set; } = "Dinner";
    [Parameter] public string SelectSlotHint { get; set; } = "Click a band to view details.";
    [Parameter] public string UnknownBandLabel { get; set; } = "Unknown";
    [Parameter] public string PickBandLabel { get; set; } = "Pick band";
    [Parameter] public string PickStageLabel { get; set; } = "Pick stage";
    [Parameter] public string AddSlotLabel { get; set; } = "+ Add slot";
    [Parameter] public string UpdateBtnLabel { get; set; } = "Update";
    [Parameter] public string ScheduleOptionsBtnLabel { get; set; } = "Schedule options";
    [Parameter] public string ScheduleOptionsTitle { get; set; } = "Schedule options";
    [Parameter] public string VenueOptionsBtnLabel { get; set; } = "Venue options";
    [Parameter] public string EarlyChainHeading { get; set; } = "Early chain";
    [Parameter] public string PreShowHeading { get; set; } = "Pre-show";
    [Parameter] public string PostShowHeading { get; set; } = "Post-show";
    [Parameter] public string BackstageRowLabel { get; set; } = "Backstage";
    [Parameter] public string ConstraintsHeading { get; set; } = "Constraints";
    [Parameter] public string HasPersonalCurfewLabel { get; set; } = "Personal curfew";
    [Parameter] public string CateringLabel { get; set; } = "Catering";
    [Parameter] public string StartLabel { get; set; } = "Start";
    [Parameter] public string EndLabel { get; set; } = "End";
    [Parameter] public string OverrideFlagsHeading { get; set; } = "Overrides";
    [Parameter] public string AllowSoundcheckOverlapLabel { get; set; } = "Allow soundcheck overlap";
    [Parameter] public string AllowOnStageOverlapLabel { get; set; } = "Allow on-stage overlap";
    [Parameter] public string AddEventBtn { get; set; } = "+ Add";
    [Parameter] public string AddEventPickerTitle { get; set; } = "Add event";
    [Parameter] public string AddEventPlacementHint { get; set; } = "Event will be placed automatically.";
    [Parameter] public string TemplateTitle { get; set; } = "Timing template";
    [Parameter] public string EarlyChainLabel { get; set; } = "Early chain";
    [Parameter] public string PreShowLabel { get; set; } = "Pre-show (closest to anchor first)";
    [Parameter] public string PostShowLabel { get; set; } = "Post-show";
    [Parameter] public string DefaultSetLengthLabel { get; set; } = "Default set length (min)";
    [Parameter] public string PresetFestivalMainStage { get; set; } = "Festival main stage";
    [Parameter] public string PresetFestivalTent { get; set; } = "Festival tent";
    [Parameter] public string PresetTraditionalVenue { get; set; } = "Traditional venue";
    [Parameter] public string VenueOptionsTitle { get; set; } = "Venue options";
    [Parameter] public string RunningOrderOptionsHeading { get; set; } = "Running order options";
    [Parameter] public string CloseLabel { get; set; } = "Done";
    [Parameter] public string CancelLabel { get; set; } = "Cancel";
    [Parameter] public string ModeChangeConfirmTitle { get; set; } = "Change schedule mode?";
    [Parameter] public string ModeChangeConfirmMessage { get; set; } = "Changing the schedule mode will recalculate all band timings. Pinned times are preserved, but unpinned events will be re-placed. Continue?";
    [Parameter] public string ModeChangeConfirmLabel { get; set; } = "Change mode";
    [Parameter] public string VenueGetInLabel { get; set; } = "Get-in";
    [Parameter] public string VenueLoadInVenueLabel { get; set; } = "Load-in (venue)";
    [Parameter] public string VenueStageLoadInLabel { get; set; } = "Load-in (stage)";
    [Parameter] public string VenueBackstageDropLabel { get; set; } = "Backstage drop";
    [Parameter] public string VenueSetupOnStageLabel { get; set; } = "Setup on stage";
    [Parameter] public string VenueSoundcheckLabel { get; set; } = "Soundcheck";
    [Parameter] public string VenuePreShowLinecheckLabel { get; set; } = "Line check";
    [Parameter] public string VenueBackstageLeadLabel { get; set; } = "Backstage lead";
    [Parameter] public string VenueChangeoverLabel { get; set; } = "Changeover";
    [Parameter] public string VenueSetLengthLabel { get; set; } = "Set length";

    private Guid _selectedSlotId = Guid.Empty;
    private bool _showScheduleOptions = false;
    private Guid _newSlotBandId = Guid.Empty;
    private int _newSlotStageId = 0;
    private bool _showVenueOptions = false;
    private bool _editingBreak = false;
    private bool _editingGap = false;
    private int _breakEditValue;
    private int _gapEditValue;
    private ElementReference _breakInputRef;
    private ElementReference _gapInputRef;
    private bool _focusBreakPending;
    private bool _focusGapPending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusBreakPending)
        {
            _focusBreakPending = false;
            try { await _breakInputRef.FocusAsync(); } catch { /* ref not yet bound */ }
        }
        if (_focusGapPending)
        {
            _focusGapPending = false;
            try { await _gapInputRef.FocusAsync(); } catch { /* ref not yet bound */ }
        }
    }

    private DateTime BaseDate => Show.DateOfOpening == default
        ? DateTime.Today
        : Show.DateOfOpening.AddDays(Math.Max(0, Order.ShowDayNumber - 1)).ToDateTime(TimeOnly.MinValue);

    private RunningOrderSlot? SelectedSlot => Order.Slots.FirstOrDefault(s => s.Id == _selectedSlotId);

    private string SelectedBandName
    {
        get
        {
            var slot = SelectedSlot;
            if (slot is null) return "Band";
            var band = Bands.FirstOrDefault(b => b.Id == slot.BandId);
            return band?.Name ?? UnknownBandLabel;
        }
    }

    private string SelectedStageName
    {
        get
        {
            var slot = SelectedSlot;
            if (slot is null) return string.Empty;
            return Stages.FirstOrDefault(s => s.Id == slot.StageId)?.Name ?? string.Empty;
        }
    }

    private bool CanAddSlot => Bands.Count > 0;

    private FestivalTimingTemplate GetOrCreateTemplate()
    {
        Order.FestivalTemplate ??= new FestivalTimingTemplate();
        return Order.FestivalTemplate;
    }

    private VenueTimingOptions GetOrCreateVenueOptions()
    {
        Order.VenueOptions ??= new VenueTimingOptions();
        return Order.VenueOptions;
    }

    private void OnSelectSlot(Guid slotId) => _selectedSlotId = slotId;

    private void OnModeChanged(ChangeEventArgs e)
    {
        if (e.Value is string s && Enum.TryParse<ScheduleMode>(s, out var m))
            Order.ModeOverride = m;
        else
            Order.ModeOverride = null;
        Notify();
    }

    private void OnAnchorChanged(ChangeEventArgs e)
    {
        if (e.Value is string s && Enum.TryParse<TimingEventType>(s, out var t))
            Order.AnchorEventOverride = t;
        else
            Order.AnchorEventOverride = null;
        Notify();
    }

    private void OnOverrideInt(ChangeEventArgs e, Action<int?> setter)
    {
        if (int.TryParse(e.Value?.ToString(), out var v) && v >= 0)
            setter(v);
        else
            setter(null);
        Notify();
    }

    private void OnOverrideInt(int? directValue, Action<int?> setter)
    {
        setter(directValue is >= 0 ? directValue : null);
        Notify();
    }

    private void AddSlot()
    {
        if (_newSlotBandId == Guid.Empty || Bands.All(b => b.Id != _newSlotBandId)) return;
        var stageId = Stages.Count > 0 ? (_newSlotStageId != 0 ? _newSlotStageId : Stages.First().Id) : 0;
        var mode = Order.ModeOverride ?? Show.DefaultScheduleMode;
        DateTime? pinnedTime = null;
        if (mode == ScheduleMode.Festival)
        {
            var rawFirstShow = Order.FirstShowTimeOverride ?? Show.FirstShowTime;
            var firstShow = rawFirstShow.HasValue
                ? BaseDate.Date.Add(rawFirstShow.Value.TimeOfDay)
                : BaseDate.AddHours(20);
            var stageSlotCount = Order.Slots.Count(s => s.StageId == stageId);
            var defaultSetLen = Order.VenueOptions?.DefaultSetLengthMinutes ?? 45;
            pinnedTime = firstShow.AddMinutes(stageSlotCount * (defaultSetLen + 15));
        }
        Order.Slots.Add(new RunningOrderSlot
        {
            Id = Guid.NewGuid(),
            BandId = _newSlotBandId,
            StageId = stageId,
            SoundcheckOrderIndex = Order.Slots.Count,
            OnStageTime = pinnedTime,
            IsOnStagePinned = pinnedTime.HasValue,
        });
        _newSlotBandId = Guid.Empty;
        _newSlotStageId = 0;
        Notify();
    }

    private void OnAddEvent(TimingEventType type)
    {
        var slot = SelectedSlot;
        if (slot is null) return;
        var ev = new SlotTimingEvent { EventType = type };
        if (type == TimingEventType.CATERING || type == TimingEventType.BACKSTAGE_WAIT)
            slot.PreShowEvents.Add(ev);
        else if (type == TimingEventType.LOAD_OUT_STAGING || type == TimingEventType.LOAD_OUT_VENUE)
            slot.PostShowEvents.Add(ev);
        else
            slot.PreShowEvents.Add(ev);
        Notify();
    }

    private void MoveSlotUp(Guid slotId)
    {
        var idx = Order.Slots.FindIndex(s => s.Id == slotId);
        if (idx <= 0) return;
        var slot = Order.Slots[idx];
        Order.Slots.RemoveAt(idx);
        Order.Slots.Insert(idx - 1, slot);
        Notify();
    }

    private void MoveSlotDown(Guid slotId)
    {
        var idx = Order.Slots.FindIndex(s => s.Id == slotId);
        if (idx < 0 || idx >= Order.Slots.Count - 1) return;
        var slot = Order.Slots[idx];
        Order.Slots.RemoveAt(idx);
        Order.Slots.Insert(idx + 1, slot);
        Notify();
    }

    private void RemoveSlot(Guid slotId)
    {
        var idx = Order.Slots.FindIndex(s => s.Id == slotId);
        if (idx < 0) return;
        Order.Slots.RemoveAt(idx);
        if (_selectedSlotId == slotId)
            _selectedSlotId = Guid.Empty;
        Notify();
    }

    private void Notify() => OnChange.InvokeAsync();

    private void SaveBreakAndClear()
    {
        OnOverrideInt(_breakEditValue, v => Order.BreakTimeMinutesOverride = v);
        _editingBreak = false;
    }

    private void SaveGapAndClear()
    {
        OnOverrideInt(_gapEditValue, v => Order.SoundcheckGapMinutesOverride = v);
        _editingGap = false;
    }

    private void StartEditingBreak()
    {
        _breakEditValue = Order.BreakTimeMinutesOverride ?? Show.BreakTimeMinutes;
        _editingBreak = true;
        _focusBreakPending = true;
    }

    private void StartEditingGap()
    {
        _gapEditValue = Order.SoundcheckGapMinutesOverride ?? Show.SoundcheckGapMinutes;
        _editingGap = true;
        _focusGapPending = true;
    }

    private void HandleBreakKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            SaveBreakAndClear();
    }

    private void HandleGapKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            SaveGapAndClear();
    }

}
