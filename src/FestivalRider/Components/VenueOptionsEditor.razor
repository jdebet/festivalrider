@using FestivalRider.Models

@if (Visible)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Title</h5>
                    <button type="button" class="btn-close" @onclick="() => VisibleChanged.InvokeAsync(false)"></button>
                </div>
                <div class="modal-body">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>@OptionNameHeading</th>
                                <th style="width: 80px;">@ToggleHeading</th>
                                <th style="width: 140px;">@DurationHeading</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>@GetInLabel</td>
                                <td><input type="checkbox" class="form-check-input" checked="@Options.IncludeGetIn" @onchange="e => SetToggle(v => Options.IncludeGetIn = v, e.Value)" /></td>
                                <td><input type="number" class="form-control form-control-sm" style="width: 80px;" step="5" value="@Options.DefaultGetInMinutes" @onchange="e => SetDuration(v => Options.DefaultGetInMinutes = v, e.Value)" /></td>
                            </tr>
                            <tr>
                                <td>@LoadInVenueLabel</td>
                                <td><input type="checkbox" class="form-check-input" checked="@Options.IncludeLoadInVenue" @onchange="e => SetToggle(v => Options.IncludeLoadInVenue = v, e.Value)" /></td>
                                <td><input type="number" class="form-control form-control-sm" style="width: 80px;" step="5" value="@Options.DefaultLoadInVenueMinutes" @onchange="e => SetDuration(v => Options.DefaultLoadInVenueMinutes = v, e.Value)" /></td>
                            </tr>
                            <tr>
                                <td>@BackstageDropLabel</td>
                                <td><input type="checkbox" class="form-check-input" checked="@Options.IncludeBackstageDrop" @onchange="e => SetToggle(v => Options.IncludeBackstageDrop = v, e.Value)" /></td>
                                <td><input type="number" class="form-control form-control-sm" style="width: 80px;" step="5" value="@Options.DefaultBackstageDropMinutes" @onchange="e => SetDuration(v => Options.DefaultBackstageDropMinutes = v, e.Value)" /></td>
                            </tr>
                            <tr>
                                <td>@StageLoadInLabel</td>
                                <td><input type="checkbox" class="form-check-input" checked="@Options.IncludeStageLoadIn" @onchange="e => SetToggle(v => Options.IncludeStageLoadIn = v, e.Value)" /></td>
                                <td><input type="number" class="form-control form-control-sm" style="width: 80px;" step="5" value="@Options.DefaultStageLoadInMinutes" @onchange="e => SetDuration(v => Options.DefaultStageLoadInMinutes = v, e.Value)" /></td>
                            </tr>
                            <tr>
                                <td>@SetupOnStageLabel</td>
                                <td><input type="checkbox" class="form-check-input" checked="@Options.IncludeSetupOnStage" @onchange="e => SetToggle(v => Options.IncludeSetupOnStage = v, e.Value)" /></td>
                                <td><input type="number" class="form-control form-control-sm" style="width: 80px;" step="5" value="@Options.DefaultSetupOnStageMinutes" @onchange="e => SetDuration(v => Options.DefaultSetupOnStageMinutes = v, e.Value)" /></td>
                            </tr>
                            <tr>
                                <td>@SoundcheckLabel</td>
                                <td><input type="checkbox" class="form-check-input" checked="@Options.IncludeSoundcheck" @onchange="e => SetToggle(v => Options.IncludeSoundcheck = v, e.Value)" /></td>
                                <td><input type="number" class="form-control form-control-sm" style="width: 80px;" step="5" value="@Options.DefaultSoundcheckMinutes" @onchange="e => SetDuration(v => Options.DefaultSoundcheckMinutes = v, e.Value)" /></td>
                            </tr>
                            <tr>
                                <td>@BackstageLeadLabel</td>
                                <td></td>
                                <td><input type="number" class="form-control form-control-sm" style="width: 80px;" step="5" value="@Options.DefaultBackstageLeadMinutes" @onchange="e => SetDuration(v => Options.DefaultBackstageLeadMinutes = v, e.Value)" /></td>
                            </tr>
                            <tr>
                                <td>@ChangeoverLabel</td>
                                <td></td>
                                <td><input type="number" class="form-control form-control-sm" style="width: 80px;" step="5" value="@Options.DefaultChangeoverMinutes" @onchange="e => SetDuration(v => Options.DefaultChangeoverMinutes = v, e.Value)" /></td>
                            </tr>
                            <tr>
                                <td>@PreShowLinecheckLabel</td>
                                <td><input type="checkbox" class="form-check-input" checked="@Options.IncludePreShowLinecheck" @onchange="e => SetToggle(v => Options.IncludePreShowLinecheck = v, e.Value)" /></td>
                                <td><input type="number" class="form-control form-control-sm" style="width: 80px;" step="5" value="@Options.DefaultPreShowLinecheckMinutes" @onchange="e => SetDuration(v => Options.DefaultPreShowLinecheckMinutes = v, e.Value)" /></td>
                            </tr>
                            <tr>
                                <td>@SetLengthLabel</td>
                                <td></td>
                                <td><input type="number" class="form-control form-control-sm" style="width: 80px;" step="5" value="@Options.DefaultSetLengthMinutes" @onchange="e => SetDuration(v => Options.DefaultSetLengthMinutes = v, e.Value)" /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => VisibleChanged.InvokeAsync(false)">@CloseLabel</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public VenueTimingOptions Options { get; set; } = new();
    [Parameter] public EventCallback OnChange { get; set; }
    [Parameter] public string Title { get; set; } = "Venue options";
    [Parameter] public string OptionNameHeading { get; set; } = "Venue option";
    [Parameter] public string ToggleHeading { get; set; } = "Include";
    [Parameter] public string DurationHeading { get; set; } = "Duration (min)";
    [Parameter] public string CloseLabel { get; set; } = "Done";
    [Parameter] public string GetInLabel { get; set; } = "Get-in";
    [Parameter] public string LoadInVenueLabel { get; set; } = "Load-in (venue)";
    [Parameter] public string StageLoadInLabel { get; set; } = "Load-in (stage)";
    [Parameter] public string BackstageDropLabel { get; set; } = "Backstage drop";
    [Parameter] public string SetupOnStageLabel { get; set; } = "Setup on stage";
    [Parameter] public string SoundcheckLabel { get; set; } = "Soundcheck";
    [Parameter] public string PreShowLinecheckLabel { get; set; } = "Pre-show line check";
    [Parameter] public string BackstageLeadLabel { get; set; } = "Backstage lead";
    [Parameter] public string ChangeoverLabel { get; set; } = "Changeover";
    [Parameter] public string SetLengthLabel { get; set; } = "Set length";

    private void SetToggle(Action<bool> setter, object? value)
    {
        if (value is bool b) setter(b);
        else if (bool.TryParse(value?.ToString(), out var parsed)) setter(parsed);
        Notify();
    }

    private void SetDuration(Action<int> setter, object? value)
    {
        if (int.TryParse(value?.ToString(), out var v)) setter(v);
        Notify();
    }

    private void Notify() => OnChange.InvokeAsync();
}
