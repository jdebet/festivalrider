<div class="d-flex align-items-center gap-1">
    <label class="small text-muted mb-0">@Label</label>
    <input type="time" class="form-control form-control-sm" style="width: 100px;"
           value="@FormatValue(Value)"
           @onchange="OnChanged" />
    @if (ShowDayBadge)
    {
        var dayOffset = GetDayOffset(Value);
        if (dayOffset > 0)
        {
            <span class="badge bg-secondary">+@dayOffset d</span>
        }
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public DateTime BaseDate { get; set; }
    [Parameter] public EventCallback<DateTime?> OnChange { get; set; }
    [Parameter] public bool ShowDayBadge { get; set; } = true;

    private string? FormatValue(DateTime? dt) => dt?.ToString("HH:mm");

    private int GetDayOffset(DateTime? dt)
    {
        if (dt is null) return 0;
        return (int)(dt.Value.Date - BaseDate.Date).TotalDays;
    }

    private void OnChanged(ChangeEventArgs e)
    {
        if (e.Value is string s && TimeOnly.TryParse(s, out var t))
        {
            var dayOffset = GetDayOffset(Value);
            var result = BaseDate.Date.AddDays(dayOffset).Add(t.ToTimeSpan());
            OnChange.InvokeAsync(result);
        }
        else
        {
            OnChange.InvokeAsync(null);
        }
    }
}
