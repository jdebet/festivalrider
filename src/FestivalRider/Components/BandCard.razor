@* Compact band tile for BandList. No service injection; inputs via Band, outputs via callbacks. *@
<div class="card h-100">
    <div class="card-body d-flex flex-column">
        <h5 class="card-title mb-1">@Band.Name</h5>
        <p class="card-text text-muted small mb-2">
            <small class="text-muted">
                @string.Format(ContactsSummaryFormat, Band.Contacts.Count) &bull; @string.Format(TravellersSummaryFormat, Band.TravelParty.Members.Count)
            </small>
        </p>
        @if (!string.IsNullOrWhiteSpace(Band.Notes))
        {
            <p class="card-text small flex-grow-1">@Band.Notes</p>
        }
        else
        {
            <div class="flex-grow-1"></div>
        }
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-primary" @onclick="HandleEdit">@EditLabel</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="HandlePrint">@PrintLabel</button>
            <button type="button" class="btn btn-outline-danger" @onclick="HandleDelete">@DeleteLabel</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Band Band { get; set; } = default!;
    [Parameter] public EventCallback<Guid> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback<Guid> OnPrint { get; set; }
    [Parameter] public string EditLabel { get; set; } = "Edit";
    [Parameter] public string PrintLabel { get; set; } = "Print";
    [Parameter] public string DeleteLabel { get; set; } = "Delete";
    [Parameter] public string ContactsSummaryFormat { get; set; } = "{0} contact(s)";
    [Parameter] public string TravellersSummaryFormat { get; set; } = "{0} traveller(s)";

    private Task HandleEdit() => OnEdit.InvokeAsync(Band.Id);
    private Task HandleDelete() => OnDelete.InvokeAsync(Band.Id);
    private Task HandlePrint() => OnPrint.InvokeAsync(Band.Id);
}
