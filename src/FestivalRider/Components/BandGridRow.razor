@* Dense band grid row block. No service/localization injection; all strings via Labels [Parameter]. *@
@using FestivalRider.Models

<EditForm Model="Band" @key="Band.Id" class="@RowClass">
    <DataAnnotationsValidator />

    @* ── FROZEN: Lock + Name + Actions ──────────────────────────── *@
    <div class="fr-grid-cell fr-grid-cell-frozen" style="left:0; width:2.2rem; min-width:2.2rem; z-index:3;">
        <button type="button" class="fr-grid-lock-btn" title="@(Locked ? Labels.Unlock : Labels.Lock)" @onclick="HandleToggleLock">
            @(Locked ? "🔒" : "🔓")
        </button>
    </div>
    <div class="fr-grid-cell fr-grid-cell-frozen fr-grid-cell-group-end" style="left:2.2rem; width:11rem; min-width:11rem; z-index:3;">
        <InputText class="form-control form-control-sm fr-form-ultra-sm w-100" @bind-Value="Band.Name" @onblur="HandleBlur" disabled="@Locked" />
        <ValidationMessage For="@(() => Band.Name)" class="small text-danger" />
    </div>
    <div class="fr-grid-cell fr-grid-cell-frozen fr-grid-cell-group-end" style="left:13.2rem; width:6.5rem; min-width:6.5rem; z-index:3;">
        <div class="d-flex flex-column gap-1">
            <button type="button" class="btn btn-xs btn-outline-secondary fr-form-ultra-sm fr-grid-action-row" @onclick="HandleEditDetail">@Labels.EditDetail</button>
            <button type="button" class="btn btn-xs btn-outline-danger fr-form-ultra-sm fr-grid-action-row fr-grid-action-minor" @onclick="HandleDelete">@Labels.Delete</button>
        </div>
    </div>

    @* ── GROUP: Band ─────────────────────────────────────────────── *@
    <div class="fr-grid-cell fr-grid-cell-group-end" style="width:14rem; min-width:14rem;">
        <InputTextArea class="form-control form-control-sm fr-form-ultra-sm w-100" rows="2" @bind-Value="Band.Notes" @onblur="HandleBlur" disabled="@Locked" />
    </div>

    @* ── GROUP: Contacts ─────────────────────────────────────────── *@
    <div class="fr-grid-cell" style="width:9rem; min-width:9rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Contacts.Count; i++)
            {
                var contact = Band.Contacts[i];
                <div class="fr-grid-sub-entry">
                    <InputSelect class="form-select form-select-sm fr-form-ultra-sm" style="width:9rem;" @bind-Value="contact.Role" @onblur="HandleBlur" disabled="@Locked">
                        @foreach (var r in Enum.GetValues<ContactRole>())
                        {
                            <option value="@r">@r</option>
                        }
                    </InputSelect>
                </div>
            }
            @if (!Locked)
            {
                <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-primary fr-grid-action-minor" @onclick="AddContact">+</button>
            }
        </div>
    </div>
    <div class="fr-grid-cell" style="width:8rem; min-width:8rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Contacts.Count; i++)
            {
                var contact = Band.Contacts[i];
                <InputText class="form-control form-control-sm fr-form-ultra-sm" @bind-Value="contact.Name" @onblur="HandleBlur" disabled="@Locked" />
            }
        </div>
    </div>
    <div class="fr-grid-cell" style="width:11rem; min-width:11rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Contacts.Count; i++)
            {
                var contact = Band.Contacts[i];
                <InputText class="form-control form-control-sm fr-form-ultra-sm" @bind-Value="contact.Email" @onblur="HandleBlur" disabled="@Locked" />
            }
        </div>
    </div>
    <div class="fr-grid-cell fr-grid-cell-group-end" style="width:8rem; min-width:8rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Contacts.Count; i++)
            {
                var idx = i;
                var contact = Band.Contacts[idx];
                <div class="fr-grid-sub-entry">
                    <InputText class="form-control form-control-sm fr-form-ultra-sm" style="flex:1;" @bind-Value="contact.Phone" @onblur="HandleBlur" disabled="@Locked" />
                    @if (!Locked)
                    {
                        <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-danger fr-grid-action-minor" @onclick="() => RemoveContact(idx)">×</button>
                    }
                </div>
            }
        </div>
    </div>

    @* ── GROUP: Travel Party ──────────────────────────────────────── *@
    <div class="fr-grid-cell" style="width:8rem; min-width:8rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.TravelParty.Members.Count; i++)
            {
                var m = Band.TravelParty.Members[i];
                <div class="fr-grid-sub-entry">
                    <InputSelect class="form-select form-select-sm fr-form-ultra-sm" style="width:8rem;" @bind-Value="m.Type" @onblur="HandleBlur" disabled="@Locked">
                        @foreach (var t in Enum.GetValues<PartyType>())
                        {
                            <option value="@t">@t</option>
                        }
                    </InputSelect>
                </div>
            }
            @if (!Locked)
            {
                <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-primary fr-grid-action-minor" @onclick="AddPartyMember">+</button>
            }
        </div>
    </div>
    <div class="fr-grid-cell" style="width:7rem; min-width:7rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.TravelParty.Members.Count; i++)
            {
                var m = Band.TravelParty.Members[i];
                <InputText class="form-control form-control-sm fr-form-ultra-sm" @bind-Value="m.Role" @onblur="HandleBlur" disabled="@Locked" />
            }
        </div>
    </div>
    <div class="fr-grid-cell fr-grid-cell-group-end" style="width:8rem; min-width:8rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.TravelParty.Members.Count; i++)
            {
                var idx = i;
                var m = Band.TravelParty.Members[idx];
                <div class="fr-grid-sub-entry">
                    <InputText class="form-control form-control-sm fr-form-ultra-sm" style="flex:1;" @bind-Value="m.Name" @onblur="HandleBlur" disabled="@Locked" />
                    @if (!Locked)
                    {
                        <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-danger fr-grid-action-minor" @onclick="() => RemovePartyMember(idx)">×</button>
                    }
                </div>
            }
        </div>
    </div>

    @* ── GROUP: Cabling ───────────────────────────────────────────── *@
    <div class="fr-grid-cell" style="width:8rem; min-width:8rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Rider.Tech.Cables.Count; i++)
            {
                var c = Band.Rider.Tech.Cables[i];
                <InputSelect class="form-select form-select-sm fr-form-ultra-sm" @bind-Value="c.Source" @onblur="HandleBlur" disabled="@Locked">
                    @foreach (var p in Enum.GetValues<CablePoint>())
                    { <option value="@p">@p</option> }
                </InputSelect>
            }
            @if (!Locked)
            {
                <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-primary fr-grid-action-minor" @onclick="AddCable">+</button>
            }
        </div>
    </div>
    <div class="fr-grid-cell" style="width:8rem; min-width:8rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Rider.Tech.Cables.Count; i++)
            {
                var c = Band.Rider.Tech.Cables[i];
                <InputSelect class="form-select form-select-sm fr-form-ultra-sm" @bind-Value="c.Target" @onblur="HandleBlur" disabled="@Locked">
                    @foreach (var p in Enum.GetValues<CablePoint>())
                    { <option value="@p">@p</option> }
                </InputSelect>
            }
        </div>
    </div>
    <div class="fr-grid-cell" style="width:7rem; min-width:7rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Rider.Tech.Cables.Count; i++)
            {
                var c = Band.Rider.Tech.Cables[i];
                <InputSelect class="form-select form-select-sm fr-form-ultra-sm" @bind-Value="c.Type" @onblur="HandleBlur" disabled="@Locked">
                    @foreach (var t in Enum.GetValues<CableType>())
                    { <option value="@t">@t</option> }
                </InputSelect>
            }
        </div>
    </div>
    <div class="fr-grid-cell" style="width:6rem; min-width:6rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Rider.Tech.Cables.Count; i++)
            {
                var c = Band.Rider.Tech.Cables[i];
                <InputText class="form-control form-control-sm fr-form-ultra-sm" @bind-Value="c.CategoryOrSpec" @onblur="HandleBlur" disabled="@Locked" />
            }
        </div>
    </div>
    <div class="fr-grid-cell" style="width:5rem; min-width:5rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Rider.Tech.Cables.Count; i++)
            {
                var c = Band.Rider.Tech.Cables[i];
                <InputNumber class="form-control form-control-sm fr-form-ultra-sm" step="5" @bind-Value="c.MinLengthMeters" @onblur="HandleBlur" disabled="@Locked" />
            }
        </div>
    </div>
    <div class="fr-grid-cell" style="width:5rem; min-width:5rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Rider.Tech.Cables.Count; i++)
            {
                var c = Band.Rider.Tech.Cables[i];
                <InputNumber class="form-control form-control-sm fr-form-ultra-sm" step="5" @bind-Value="c.MaxLengthMeters" @onblur="HandleBlur" disabled="@Locked" />
            }
        </div>
    </div>
    <div class="fr-grid-cell fr-grid-cell-group-end" style="width:6rem; min-width:6rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Rider.Tech.Cables.Count; i++)
            {
                var idx = i;
                var c = Band.Rider.Tech.Cables[idx];
                <div class="fr-grid-sub-entry">
                    <InputSelect class="form-select form-select-sm fr-form-ultra-sm" style="flex:1;" @bind-Value="c.Provider" @onblur="HandleBlur" disabled="@Locked">
                        @foreach (var p in Enum.GetValues<CableProvider>())
                        { <option value="@p">@p</option> }
                    </InputSelect>
                    @if (!Locked)
                    {
                        <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-danger fr-grid-action-minor" @onclick="() => RemoveCable(idx)">×</button>
                    }
                </div>
            }
        </div>
    </div>

    @* ── GROUP: Lighting ──────────────────────────────────────────── *@
    <div class="fr-grid-cell" style="width:9rem; min-width:9rem;">
        <InputText class="form-control form-control-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Lighting.OwnConsoleModel" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell" style="width:5rem; min-width:5rem;">
        <InputNumber class="form-control form-control-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Lighting.BackdropWidthMeters" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell" style="width:5rem; min-width:5rem;">
        <InputNumber class="form-control form-control-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Lighting.BackdropHeightMeters" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell fr-grid-cell-group-end" style="width:14rem; min-width:14rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Rider.Tech.Lighting.FloorMachines.Count; i++)
            {
                var idx = i;
                var m = Band.Rider.Tech.Lighting.FloorMachines[idx];
                <div class="fr-grid-sub-entry">
                    <InputText class="form-control form-control-sm fr-form-ultra-sm" style="flex:2;" placeholder="@Labels.FieldLightingModelOrType" @bind-Value="m.Name" @onblur="HandleBlur" disabled="@Locked" />
                    <InputText class="form-control form-control-sm fr-form-ultra-sm" style="flex:1;" placeholder="@Labels.FieldLightingLocation" @bind-Value="m.Location" @onblur="HandleBlur" disabled="@Locked" />
                    <InputNumber class="form-control form-control-sm fr-form-ultra-sm" style="width:3.5rem;" @bind-Value="m.Count" @onblur="HandleBlur" disabled="@Locked" />
                    @if (!Locked)
                    {
                        <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-danger fr-grid-action-minor" @onclick="() => RemoveFloorMachine(idx)">×</button>
                    }
                </div>
            }
            @if (!Locked)
            {
                <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-primary fr-grid-action-minor" @onclick="AddFloorMachine">+</button>
            }
        </div>
    </div>

    @* ── GROUP: Power ─────────────────────────────────────────────── *@
    <div class="fr-grid-cell" style="width:7rem; min-width:7rem;">
        <InputSelect class="form-select form-select-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Power.Amperage" @onblur="HandleBlur" disabled="@Locked">
            @foreach (var a in Enum.GetValues<PowerAmperage>())
            { <option value="@a">@a</option> }
        </InputSelect>
    </div>
    <div class="fr-grid-cell" style="width:7rem; min-width:7rem;">
        <InputSelect class="form-select form-select-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Power.Phase" @onblur="HandleBlur" disabled="@Locked">
            @foreach (var p in Enum.GetValues<PowerPhase>())
            { <option value="@p">@p</option> }
        </InputSelect>
    </div>
    <div class="fr-grid-cell fr-grid-cell-group-end" style="width:11rem; min-width:11rem;">
        <InputText class="form-control form-control-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Power.AdapterNotes" @onblur="HandleBlur" disabled="@Locked" />
    </div>

    @* ── GROUP: FOH ───────────────────────────────────────────────── *@
    <div class="fr-grid-cell" style="width:9rem; min-width:9rem;">
        <InputText class="form-control form-control-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Foh.OwnConsoleModel" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell" style="width:7rem; min-width:7rem;">
        <InputSelect class="form-select form-select-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Foh.OutputProtocol" @onblur="HandleBlur" disabled="@Locked">
            @foreach (var p in Enum.GetValues<OutputProtocol>())
            { <option value="@p">@p</option> }
        </InputSelect>
    </div>
    <div class="fr-grid-cell" style="width:7rem; min-width:7rem;">
        <InputSelect class="form-select form-select-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Foh.OutputLocation" @onblur="HandleBlur" disabled="@Locked">
            @foreach (var l in Enum.GetValues<OutputLocation>())
            { <option value="@l">@l</option> }
        </InputSelect>
    </div>
    <div class="fr-grid-cell" style="width:10rem; min-width:10rem;">
        <InputText class="form-control form-control-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Foh.OutputNotes" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell" style="width:4rem; min-width:4rem;">
        <InputNumber class="form-control form-control-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Foh.StageToFohSendCount" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell" style="width:4rem; min-width:4rem;">
        <InputNumber class="form-control form-control-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Foh.StageToFohRoundTripCount" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell" style="width:4.5rem; min-width:4.5rem;">
        <InputNumber class="form-control form-control-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Foh.FootprintWidthMeters" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell" style="width:4.5rem; min-width:4.5rem;">
        <InputNumber class="form-control form-control-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Foh.FootprintLengthMeters" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell" style="width:10rem; min-width:10rem;">
        <InputText class="form-control form-control-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Foh.AdditionalHardware" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell fr-grid-cell-group-end" style="width:12rem; min-width:12rem;">
        <InputTextArea class="form-control form-control-sm fr-form-ultra-sm w-100" rows="2" @bind-Value="Band.Rider.Tech.Foh.Notes" @onblur="HandleBlur" disabled="@Locked" />
    </div>

    @* ── GROUP: Monitors ──────────────────────────────────────────── *@
    <div class="fr-grid-cell" style="width:8rem; min-width:8rem;">
        <InputSelect class="form-select form-select-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Monitors.SourceMode" @onblur="HandleBlur" disabled="@Locked">
            @foreach (var m in Enum.GetValues<MonitorSourceMode>())
            { <option value="@m">@m</option> }
        </InputSelect>
    </div>
    <div class="fr-grid-cell" style="width:9rem; min-width:9rem;">
        <InputText class="form-control form-control-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Monitors.OwnConsoleModel" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell" style="width:8rem; min-width:8rem;">
        <InputSelect class="form-select form-select-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Tech.Monitors.OwnConsoleLocation" @onblur="HandleBlur" disabled="@Locked">
            @foreach (var l in Enum.GetValues<MonitorTechLocation>())
            { <option value="@l">@l</option> }
        </InputSelect>
    </div>
    <div class="fr-grid-cell" style="width:16rem; min-width:16rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Rider.Tech.Monitors.Wedges.Count; i++)
            {
                var idx = i;
                var w = Band.Rider.Tech.Monitors.Wedges[idx];
                <div class="fr-grid-sub-entry">
                    <InputText class="form-control form-control-sm fr-form-ultra-sm" style="flex:2;" @bind-Value="w.Where" @onblur="HandleBlur" disabled="@Locked" />
                    <span class="fr-form-ultra-sm text-muted">D</span><InputCheckbox class="form-check-input ms-1" @bind-Value="w.DualLinked" disabled="@Locked" />
                    <span class="fr-form-ultra-sm text-muted ms-1">S</span><InputCheckbox class="form-check-input ms-1" @bind-Value="w.Stereo" disabled="@Locked" />
                    <span class="fr-form-ultra-sm text-muted ms-1">DF</span><InputCheckbox class="form-check-input ms-1" @bind-Value="w.DrumFill" disabled="@Locked" />
                    @if (!Locked)
                    {
                        <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-danger fr-grid-action-minor" @onclick="() => RemoveWedge(idx)">×</button>
                    }
                </div>
            }
            @if (!Locked)
            {
                <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-primary fr-grid-action-minor" @onclick="AddWedge">+</button>
            }
        </div>
    </div>
    <div class="fr-grid-cell" style="width:16rem; min-width:16rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Rider.Tech.Monitors.InEars.Count; i++)
            {
                var idx = i;
                var iem = Band.Rider.Tech.Monitors.InEars[idx];
                <div class="fr-grid-sub-entry">
                    <InputText class="form-control form-control-sm fr-form-ultra-sm" style="flex:2;" @bind-Value="iem.Where" @onblur="HandleBlur" disabled="@Locked" />
                    <span class="fr-form-ultra-sm text-muted">W</span><InputCheckbox class="form-check-input ms-1" @bind-Value="iem.IsWireless" disabled="@Locked" />
                    <InputSelect class="form-select form-select-sm fr-form-ultra-sm" style="flex:1;" @bind-Value="iem.Provider" @onblur="HandleBlur" disabled="@Locked">
                        @foreach (var p in Enum.GetValues<CableProvider>())
                        { <option value="@p">@p</option> }
                    </InputSelect>
                    @if (!Locked)
                    {
                        <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-danger fr-grid-action-minor" @onclick="() => RemoveInEar(idx)">×</button>
                    }
                </div>
            }
            @if (!Locked)
            {
                <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-primary fr-grid-action-minor" @onclick="AddInEar">+</button>
            }
        </div>
    </div>
    <div class="fr-grid-cell fr-grid-cell-group-end" style="width:12rem; min-width:12rem;">
        <InputTextArea class="form-control form-control-sm fr-form-ultra-sm w-100" rows="2" @bind-Value="Band.Rider.Tech.Monitors.Notes" @onblur="HandleBlur" disabled="@Locked" />
    </div>

    @* ── GROUP: Stage ─────────────────────────────────────────────── *@
    <div class="fr-grid-cell" style="width:18rem; min-width:18rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Rider.Tech.Stage.Risers.Count; i++)
            {
                var idx = i;
                var r = Band.Rider.Tech.Stage.Risers[idx];
                <div class="fr-grid-sub-entry">
                    <InputText class="form-control form-control-sm fr-form-ultra-sm" style="flex:3;" @bind-Value="r.Where" @onblur="HandleBlur" disabled="@Locked" />
                    <InputNumber class="form-control form-control-sm fr-form-ultra-sm" style="width:4rem;" step="0.5" @bind-Value="r.WidthMeters" @onblur="HandleBlur" disabled="@Locked" />
                    <InputNumber class="form-control form-control-sm fr-form-ultra-sm" style="width:4rem;" step="0.5" @bind-Value="r.LengthMeters" @onblur="HandleBlur" disabled="@Locked" />
                    <InputNumber class="form-control form-control-sm fr-form-ultra-sm" style="width:4rem;" step="20" @bind-Value="r.HeightCm" @onblur="HandleBlur" disabled="@Locked" />
                    @if (!Locked)
                    {
                        <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-danger fr-grid-action-minor" @onclick="() => RemoveRiser(idx)">×</button>
                    }
                </div>
            }
            @if (!Locked)
            {
                <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-primary fr-grid-action-minor" @onclick="AddRiser">+</button>
            }
        </div>
    </div>
    <div class="fr-grid-cell" style="width:14rem; min-width:14rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Rider.Tech.Stage.OtherRisers.Count; i++)
            {
                var idx = i;
                var o = Band.Rider.Tech.Stage.OtherRisers[idx];
                <div class="fr-grid-sub-entry">
                    <InputText class="form-control form-control-sm fr-form-ultra-sm" style="flex:2;" @bind-Value="o.Where" @onblur="HandleBlur" disabled="@Locked" />
                    <InputSelect class="form-select form-select-sm fr-form-ultra-sm" style="flex:1;" @bind-Value="o.Type" @onblur="HandleBlur" disabled="@Locked">
                        @foreach (var t in Enum.GetValues<OtherRiserType>())
                        { <option value="@t">@t</option> }
                    </InputSelect>
                    @if (!Locked)
                    {
                        <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-danger fr-grid-action-minor" @onclick="() => RemoveOtherRiser(idx)">×</button>
                    }
                </div>
            }
            @if (!Locked)
            {
                <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-primary fr-grid-action-minor" @onclick="AddOtherRiser">+</button>
            }
        </div>
    </div>
    <div class="fr-grid-cell" style="width:16rem; min-width:16rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Rider.Tech.Stage.WirelessMics.Count; i++)
            {
                var idx = i;
                var wm = Band.Rider.Tech.Stage.WirelessMics[idx];
                <div class="fr-grid-sub-entry">
                    <InputText class="form-control form-control-sm fr-form-ultra-sm" style="flex:2;" @bind-Value="wm.Where" @onblur="HandleBlur" disabled="@Locked" />
                    <InputNumber class="form-control form-control-sm fr-form-ultra-sm" style="width:3.5rem;" @bind-Value="wm.Count" @onblur="HandleBlur" disabled="@Locked" />
                    <InputSelect class="form-select form-select-sm fr-form-ultra-sm" style="flex:1;" @bind-Value="wm.Provider" @onblur="HandleBlur" disabled="@Locked">
                        @foreach (var p in Enum.GetValues<CableProvider>())
                        { <option value="@p">@p</option> }
                    </InputSelect>
                    @if (!Locked)
                    {
                        <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-danger fr-grid-action-minor" @onclick="() => RemoveWirelessMic(idx)">×</button>
                    }
                </div>
            }
            @if (!Locked)
            {
                <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-primary fr-grid-action-minor" @onclick="AddWirelessMic">+</button>
            }
        </div>
    </div>
    <div class="fr-grid-cell" style="width:5rem; min-width:5rem; text-align:center;">
        <InputCheckbox class="form-check-input" @bind-Value="Band.Rider.Tech.Stage.BringsOwnMics" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell fr-grid-cell-group-end" style="width:12rem; min-width:12rem;">
        <InputTextArea class="form-control form-control-sm fr-form-ultra-sm w-100" rows="2" @bind-Value="Band.Rider.Tech.Stage.Notes" @onblur="HandleBlur" disabled="@Locked" />
    </div>

    @* ── GROUP: Tech Notes ────────────────────────────────────────── *@
    <div class="fr-grid-cell fr-grid-cell-group-end" style="width:14rem; min-width:14rem;">
        <InputTextArea class="form-control form-control-sm fr-form-ultra-sm w-100" rows="2" @bind-Value="Band.Rider.Tech.Notes" @onblur="HandleBlur" disabled="@Locked" />
    </div>

    @* ── GROUP: Hospitality ───────────────────────────────────────── *@
    <div class="fr-grid-cell" style="width:12rem; min-width:12rem;">
        <InputTextArea class="form-control form-control-sm fr-form-ultra-sm w-100" rows="2" @bind-Value="Band.Rider.Hospitality.DressingRoomNotes" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell" style="width:12rem; min-width:12rem;">
        <InputTextArea class="form-control form-control-sm fr-form-ultra-sm w-100" rows="2" @bind-Value="Band.Rider.Hospitality.CateringNotes" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell" style="width:10rem; min-width:10rem;">
        <InputText class="form-control form-control-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Hospitality.DietaryRestrictions" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell" style="width:4rem; min-width:4rem;">
        <InputNumber class="form-control form-control-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Hospitality.TowelCount" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell" style="width:4rem; min-width:4rem;">
        <InputNumber class="form-control form-control-sm fr-form-ultra-sm w-100" @bind-Value="Band.Rider.Hospitality.ParkingSpaces" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell" style="width:12rem; min-width:12rem;">
        <InputTextArea class="form-control form-control-sm fr-form-ultra-sm w-100" rows="2" @bind-Value="Band.Rider.Hospitality.Accommodations" @onblur="HandleBlur" disabled="@Locked" />
    </div>
    <div class="fr-grid-cell fr-grid-cell-group-end" style="width:12rem; min-width:12rem;">
        <div class="fr-grid-list-cell">
            @for (var i = 0; i < Band.Rider.Hospitality.DrinksRequests.Count; i++)
            {
                var idx = i;
                <div class="fr-grid-sub-entry">
                    <input class="form-control form-control-sm fr-form-ultra-sm" style="flex:1;"
                           value="@Band.Rider.Hospitality.DrinksRequests[idx]"
                           @oninput="e => Band.Rider.Hospitality.DrinksRequests[idx] = e.Value?.ToString() ?? string.Empty"
                           @onblur="HandleBlur"
                           disabled="@Locked" />
                    @if (!Locked)
                    {
                        <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-danger fr-grid-action-minor" @onclick="() => RemoveDrink(idx)">×</button>
                    }
                </div>
            }
            @if (!Locked)
            {
                <button type="button" class="btn btn-sm fr-form-ultra-sm btn-outline-primary fr-grid-action-minor" @onclick="AddDrink">+</button>
            }
        </div>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public Band Band { get; set; } = default!;
    [Parameter, EditorRequired] public BandGridLabels Labels { get; set; } = default!;
    [Parameter] public bool Locked { get; set; } = true;
    [Parameter] public bool Alternate { get; set; }
    [Parameter] public EventCallback OnCommit { get; set; }
    [Parameter] public EventCallback OnToggleLock { get; set; }
    [Parameter] public EventCallback OnEditDetail { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private string RowClass =>
        "fr-grid-band-row" +
        (Alternate ? " fr-grid-band-alt" : "") +
        (Locked ? " fr-grid-locked" : "");

    private Task HandleBlur() => OnCommit.InvokeAsync();
    private Task HandleToggleLock() => OnToggleLock.InvokeAsync();
    private Task HandleEditDetail() => OnEditDetail.InvokeAsync();
    private Task HandleDelete() => OnDelete.InvokeAsync();

    private void AddContact() => Band.Contacts.Add(new Contact());
    private void RemoveContact(int idx) { Band.Contacts.RemoveAt(idx); OnCommit.InvokeAsync(); }
    private void AddPartyMember() => Band.TravelParty.Members.Add(new Party());
    private void RemovePartyMember(int idx) { Band.TravelParty.Members.RemoveAt(idx); OnCommit.InvokeAsync(); }
    private void AddCable() => Band.Rider.Tech.Cables.Add(new Cable());
    private void RemoveCable(int idx) { Band.Rider.Tech.Cables.RemoveAt(idx); OnCommit.InvokeAsync(); }
    private void AddFloorMachine() => Band.Rider.Tech.Lighting.FloorMachines.Add(new LightingMachine());
    private void RemoveFloorMachine(int idx) { Band.Rider.Tech.Lighting.FloorMachines.RemoveAt(idx); OnCommit.InvokeAsync(); }
    private void AddWedge() => Band.Rider.Tech.Monitors.Wedges.Add(new MonitorWedge());
    private void RemoveWedge(int idx) { Band.Rider.Tech.Monitors.Wedges.RemoveAt(idx); OnCommit.InvokeAsync(); }
    private void AddInEar() => Band.Rider.Tech.Monitors.InEars.Add(new InEarMonitor());
    private void RemoveInEar(int idx) { Band.Rider.Tech.Monitors.InEars.RemoveAt(idx); OnCommit.InvokeAsync(); }
    private void AddRiser() => Band.Rider.Tech.Stage.Risers.Add(new Riser());
    private void RemoveRiser(int idx) { Band.Rider.Tech.Stage.Risers.RemoveAt(idx); OnCommit.InvokeAsync(); }
    private void AddOtherRiser() => Band.Rider.Tech.Stage.OtherRisers.Add(new OtherRiser());
    private void RemoveOtherRiser(int idx) { Band.Rider.Tech.Stage.OtherRisers.RemoveAt(idx); OnCommit.InvokeAsync(); }
    private void AddWirelessMic() => Band.Rider.Tech.Stage.WirelessMics.Add(new WirelessMic());
    private void RemoveWirelessMic(int idx) { Band.Rider.Tech.Stage.WirelessMics.RemoveAt(idx); OnCommit.InvokeAsync(); }
    private void AddDrink() => Band.Rider.Hospitality.DrinksRequests.Add(string.Empty);
    private void RemoveDrink(int idx) { Band.Rider.Hospitality.DrinksRequests.RemoveAt(idx); OnCommit.InvokeAsync(); }
}
