@using FestivalRider.Models

<div class="fr-gantt">
    @if (Order.Slots.Count == 0)
    {
        <p class="text-muted small">@SelectSlotHint</p>
    }
    else
    {
        var minTime = MinTime;
        var maxTime = MaxTime;
        var totalMinutes = Math.Max((maxTime - minTime).TotalMinutes, 1);

        @* Ruler with integrated marker legends — single combined track *@
        <div class="fr-gantt-tracks border rounded p-1" @onclick="() => OnSelectSlot.InvokeAsync(Guid.Empty)">
            <div class="fr-gantt-row d-flex align-items-center gap-1 mb-1">
                <div class="fr-gantt-label d-flex align-items-center justify-content-start" style="width: 175px; flex-shrink: 0;">
                </div>
                @* Combined legend+ruler track: top 20px = label zone, bottom 28px = ruler bar *@
                <div class="fr-gantt-track position-relative flex-grow-1" style="height: 48px;">
                    @* ── Ruler bar background (bottom 28px) ── *@
                    <div class="position-absolute" style="left: 0; bottom: 0; width: 100%; height: 28px; background: #f8f9fa; border-radius: 4px;"></div>

                    @* ── Shading regions (scoped to ruler bar) ── *@
                    @if (VenueOpenTime is DateTime vo)
                    {
                        var openLeft = Math.Clamp((vo - minTime).TotalMinutes / totalMinutes * 100, 0, 100);
                        <div class="position-absolute" style="left: 0; bottom: 0; width: @(openLeft.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; height: 28px; background: rgba(0,0,0,0.08); border-radius: 4px 0 0 4px;"></div>
                    }
                    @if (VenueCloseTime is DateTime vc)
                    {
                        var closeLeft = Math.Clamp((vc - minTime).TotalMinutes / totalMinutes * 100, 0, 100);
                        <div class="position-absolute" style="left: @(closeLeft.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; bottom: 0; width: @((100 - closeLeft).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; height: 28px; background: rgba(0,0,0,0.08); border-radius: 0 4px 4px 0;"></div>
                    }
                    @if (EffectiveSoundCurfew is DateTime sc && VenueCloseTime is DateTime vc2)
                    {
                        var scLeft = Math.Clamp((sc - minTime).TotalMinutes / totalMinutes * 100, 0, 100);
                        var scWidth = Math.Clamp((vc2 - sc).TotalMinutes / totalMinutes * 100, 0, 100 - scLeft);
                        <div class="position-absolute" style="left: @(scLeft.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; bottom: 0; width: @(scWidth.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; height: 28px; background: rgba(139, 0, 0, 0.12);"></div>
                    }
                    @if (EffectiveBackstageCurfew is DateTime bsc && VenueCloseTime is DateTime vc3)
                    {
                        var bscLeft = Math.Clamp((bsc - minTime).TotalMinutes / totalMinutes * 100, 0, 100);
                        var bscWidth = Math.Clamp((vc3 - bsc).TotalMinutes / totalMinutes * 100, 0, 100 - bscLeft);
                        <div class="position-absolute" style="left: @(bscLeft.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; bottom: 0; width: @(bscWidth.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; height: 28px; background: repeating-linear-gradient(45deg, rgba(0,0,0,0.05), rgba(0,0,0,0.05) 8px, rgba(0,0,0,0.12) 8px, rgba(0,0,0,0.12) 16px);"></div>
                    }

                    @* ── Hour ticks (ruler bar only) ── *@
                    @foreach (var h in RulerHours(minTime, maxTime))
                    {
                        var hLeft = Math.Clamp((h - minTime).TotalMinutes / totalMinutes * 100, 0, 100);
                        <div class="position-absolute" style="left: @(hLeft.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; bottom: 0; width: 1px; height: 28px; background: #adb5bd;"></div>
                        <span class="position-absolute" style="left: @(hLeft.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; bottom: 4px; transform: translateX(-50%); font-size: 9px; color: #6c757d; white-space: nowrap;">@h.ToString("HH:mm")</span>
                    }
                    @foreach (var q in RulerQuarters(minTime, maxTime))
                    {
                        var qLeft = Math.Clamp((q - minTime).TotalMinutes / totalMinutes * 100, 0, 100);
                        <div class="position-absolute" style="left: @(qLeft.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; bottom: 0; width: 1px; height: @(28 * 0.4)px; background: #dee2e6;"></div>
                    }
                    @if (minTime.Date != maxTime.Date)
                    {
                        var midnight = minTime.Date.AddDays(1);
                        if (midnight > minTime && midnight < maxTime)
                        {
                            var mLeft = ((midnight - minTime).TotalMinutes / totalMinutes * 100);
                            <div class="position-absolute" style="left: @(mLeft.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; bottom: 0; width: 2px; height: 100%; background: #dc3545;"></div>
                            <span class="position-absolute fw-bold" style="left: @(mLeft.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; top: 2px; transform: translateX(-50%); font-size: 8px; color: #dc3545; white-space: nowrap;">+1d</span>
                        }
                    }

                    @* ── Named venue markers — line spans full height, label at top ── *@
                    @{
                        var markers = new List<(DateTime Time, string Label, string CssClass, double Left)>();
                        if (VenueOpenTime is DateTime voM)
                            markers.Add((voM, "Open", "fr-gantt-named-marker-venue", (voM - minTime).TotalMinutes / totalMinutes * 100));
                        if (VenueCloseTime is DateTime vcM)
                            markers.Add((vcM, "Close", "fr-gantt-named-marker-venue", (vcM - minTime).TotalMinutes / totalMinutes * 100));
                        if (EffectiveTechnicalGetIn is DateTime tgiM)
                            markers.Add((tgiM, "Tech Get-In", "fr-gantt-named-marker-tech", (tgiM - minTime).TotalMinutes / totalMinutes * 100));
                        if (EffectiveSoundCurfew is DateTime scM)
                            markers.Add((scM, "Sound Curfew", "fr-gantt-named-marker-curfew", (scM - minTime).TotalMinutes / totalMinutes * 100));
                        if (EffectiveBackstageCurfew is DateTime bscM)
                            markers.Add((bscM, "Backstage Curfew", "fr-gantt-named-marker-curfew", (bscM - minTime).TotalMinutes / totalMinutes * 100));
                    }
                    @foreach (var m in markers)
                    {
                        var rtl = m.Left > 80;
                        <div class="position-absolute fr-gantt-named-marker @m.CssClass @(rtl ? "fr-gantt-named-marker-rtl" : "")" style="left: @(m.Left.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%;">
                            <div class="fr-gantt-named-marker-line"></div>
                            <span class="fr-gantt-named-marker-label">@m.Label<span class="fr-gantt-named-marker-time">@m.Time.ToString("HH:mm")</span></span>
                        </div>
                    }
                </div>
            </div>

            @foreach (var slot in Order.Slots.OrderBy(s => s.OnStageTime ?? DateTime.MaxValue))
            {
                var band = Bands.FirstOrDefault(b => b.Id == slot.BandId);
                var bandName = band?.Name ?? UnknownBandLabel;
                var isSelected = slot.Id == SelectedSlotId;

                <div class="fr-gantt-row d-flex align-items-center gap-1 py-1 @(isSelected ? "fr-gantt-row-selected" : "")"
                     @onclick="() => OnSelectSlot.InvokeAsync(slot.Id)" @onclick:stopPropagation>
                    @* Slot label & buttons *@
                    <div class="fr-gantt-label small d-flex align-items-center gap-1" style="width: 175px; flex-shrink: 0;">
                        <span class="flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; @(bandName.Length > 16 ? "font-size: 11px;" : "")">@bandName</span>
                        <button class="btn btn-sm btn-outline-secondary p-0" style="width:20px;height:20px;font-size:9px;line-height:1;flex-shrink:0;" @onclick="() => OnMoveSlotUp.InvokeAsync(slot.Id)" @onclick:stopPropagation disabled="@(!CanMoveUp(slot.Id))">&#9650;</button>
                        <button class="btn btn-sm btn-outline-secondary p-0" style="width:20px;height:20px;font-size:9px;line-height:1;flex-shrink:0;" @onclick="() => OnMoveSlotDown.InvokeAsync(slot.Id)" @onclick:stopPropagation disabled="@(!CanMoveDown(slot.Id))">&#9660;</button>
                        <button class="btn btn-sm btn-outline-danger p-0" style="width:20px;height:20px;font-size:9px;line-height:1;flex-shrink:0;" @onclick="() => OnRemoveSlot.InvokeAsync(slot.Id)" @onclick:stopPropagation>&#215;</button>
                    </div>
                    @* Slot events *@
                    <div class="fr-gantt-track position-relative flex-grow-1 @(isSelected ? "fr-gantt-track-selected" : "")" style="height: 32px; background: #f8f9fa; border-radius: 4px; overflow: hidden;">
                        @if (VenueOpenTime is DateTime voRow) {
                            var openLeftRow = Math.Clamp((voRow - minTime).TotalMinutes / totalMinutes * 100, 0, 100);
                            <div class="position-absolute" style="left: 0; top: 0; width: @(openLeftRow.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; height: 100%; background: rgba(0,0,0,0.08); border-radius: 4px 0 0 4px;"></div>
                        }
                        @if (VenueCloseTime is DateTime vcRow) {
                            var closeLeftRow = Math.Clamp((vcRow - minTime).TotalMinutes / totalMinutes * 100, 0, 100);
                            <div class="position-absolute" style="left: @(closeLeftRow.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; top: 0; width: @((100 - closeLeftRow).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; height: 100%; background: rgba(0,0,0,0.08); border-radius: 0 4px 4px 0;"></div>
                        }
                        @if (EffectiveSoundCurfew is DateTime scRow && VenueCloseTime is DateTime vcScRow) {
                            var scLeftRow = Math.Clamp((scRow - minTime).TotalMinutes / totalMinutes * 100, 0, 100);
                            var scWidthRow = Math.Clamp((vcScRow - scRow).TotalMinutes / totalMinutes * 100, 0, 100 - scLeftRow);
                            <div class="position-absolute" style="left: @(scLeftRow.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; top: 0; width: @(scWidthRow.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; height: 100%; background: rgba(139, 0, 0, 0.12);"></div>
                        }
                        @if (EffectiveBackstageCurfew is DateTime bscRow && VenueCloseTime is DateTime vcBcRow) {
                            var bscLeftRow = Math.Clamp((bscRow - minTime).TotalMinutes / totalMinutes * 100, 0, 100);
                            var bscWidthRow = Math.Clamp((vcBcRow - bscRow).TotalMinutes / totalMinutes * 100, 0, 100 - bscLeftRow);
                            <div class="position-absolute" style="left: @(bscLeftRow.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; top: 0; width: @(bscWidthRow.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; height: 100%; background: repeating-linear-gradient(45deg, rgba(0,0,0,0.05), rgba(0,0,0,0.05) 8px, rgba(0,0,0,0.12) 8px, rgba(0,0,0,0.12) 16px);"></div>
                        }
                        @foreach (var ev in AllEvents(slot)) {
                            if (ev.StartTime is null) continue;
                            var start = ev.StartTime.Value;
                            var end = start.AddMinutes(ev.DurationMinutes ?? DefaultDuration(ev.EventType));
                            if (end <= minTime || start >= maxTime) continue;
                            var visStart = start < minTime ? minTime : start;
                            var visEnd = end > maxTime ? maxTime : end;
                            var leftPct = (visStart - minTime).TotalMinutes / totalMinutes * 100;
                            var widthPct = Math.Max(0.5, (visEnd - visStart).TotalMinutes / totalMinutes * 100);
                            var color = EventColor(ev.EventType, slot);

                            <div class="position-absolute top-0 h-100 d-flex align-items-center justify-content-center"
                                 style="left: @(leftPct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; width: @(widthPct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; background: @color; border-radius: 3px; cursor: pointer; font-size: 10px; color: white; overflow: hidden; white-space: nowrap; text-shadow: 0 0 2px rgba(0,0,0,0.7); padding: 0 4px; box-sizing: border-box;"
                                 title="@ev.EventType @FormatTime(start, BaseDate)-@FormatTime(end, BaseDate)">
                                @if (widthPct > 4 && ShowInlineTime(ev.EventType)) {
                                    <span>@FormatTime(start, BaseDate)</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @* Color legend *@
            <div class="fr-gantt-row d-flex align-items-center gap-1 mt-1 pt-1" style="border-top: 1px solid #dee2e6;">
                <div class="fr-gantt-label" style="width: 175px; flex-shrink: 0;"></div>
                <div class="d-flex flex-wrap gap-2 small">
                    @foreach (var item in LegendItems())
                    {
                        <span class="fr-gantt-legend-item"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:@EventColor(item.Type);vertical-align:middle;margin-right:4px;"></span>@item.Label</span>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public RunningOrder Order { get; set; } = new();
    [Parameter] public ShowData Show { get; set; } = new();
    [Parameter] public Guid? SelectedSlotId { get; set; }
    [Parameter] public IReadOnlyList<Band> Bands { get; set; } = new List<Band>();
    [Parameter] public string SelectSlotHint { get; set; } = "Click a band to view details.";
    [Parameter] public string UnknownBandLabel { get; set; } = "Unknown";
    [Parameter] public Func<TimingEventType, string> GetEventLabel { get; set; } = t => t.ToString();
    [Parameter] public EventCallback<Guid> OnSelectSlot { get; set; }
    [Parameter] public EventCallback<SlotEditRequest> OnEditRequest { get; set; }
    [Parameter] public EventCallback<Guid> OnMoveSlotUp { get; set; }
    [Parameter] public EventCallback<Guid> OnMoveSlotDown { get; set; }
    [Parameter] public EventCallback<Guid> OnRemoveSlot { get; set; }

    private DateTime BaseDate => Show.DateOfOpening == default
        ? DateTime.Today
        : Show.DateOfOpening.AddDays(Math.Max(0, Order.ShowDayNumber - 1)).ToDateTime(TimeOnly.MinValue);

    private DateTime EventMinTime
    {
        get
        {
            var allStarts = Order.Slots
                .SelectMany(AllEvents)
                .Where(e => e.StartTime.HasValue)
                .Select(e => e.StartTime!.Value)
                .ToList();
            if (allStarts.Count == 0) return BaseDate.AddHours(8);
            return allStarts.Min().AddMinutes(-30);
        }
    }

    private DateTime EventMaxTime
    {
        get
        {
            var allEnds = Order.Slots
                .SelectMany(s => AllEvents(s).Select(e =>
                {
                    if (e.StartTime is null) return (DateTime?)null;
                    var dur = e.DurationMinutes ?? DefaultDuration(e.EventType);
                    return e.StartTime.Value.AddMinutes(dur);
                }))
                .OfType<DateTime>()
                .ToList();
            if (allEnds.Count == 0) return BaseDate.AddHours(24);
            return allEnds.Max().AddMinutes(30);
        }
    }

    private DateTime? VenueOpenTime => Order.VenueOpenTimeOverride ?? Show.VenueOpenTime;
    private DateTime? VenueCloseTime => Order.VenueCloseTimeOverride ?? Show.VenueCloseTime;
    private DateTime? EffectiveTechnicalGetIn => Order.TechnicalGetInTimeOverride ?? Show.TechnicalGetInTime;
    private DateTime? EffectiveSoundCurfew => Order.SoundCurfewTimeOverride ?? Show.SoundCurfewTime;
    private DateTime? EffectiveBackstageCurfew => Order.BackstageCurfewTimeOverride ?? Show.BackstageCurfewTime;

    private DateTime MinTime => VenueOpenTime is DateTime vo ? vo.AddHours(-1) : EventMinTime;

    private DateTime MaxTime => VenueCloseTime is DateTime vc ? vc.AddHours(1) : EventMaxTime;


    private static IEnumerable<SlotTimingEvent> AllEvents(RunningOrderSlot slot)
    {
        foreach (var e in slot.EarlyChain) yield return e;
        foreach (var e in slot.PreShowEvents) yield return e;
        if (slot.OnStageTime is DateTime onStage)
        {
            yield return new SlotTimingEvent
            {
                EventType = TimingEventType.ON_STAGE,
                StartTime = onStage,
                DurationMinutes = slot.SetLengthMinutes,
                IsPinned = slot.IsOnStagePinned,
            };
        }
        foreach (var e in slot.PostShowEvents) yield return e;
    }

    private int DefaultDuration(TimingEventType type)
    {
        var opts = Order.VenueOptions ?? new VenueTimingOptions();
        return type switch
        {
            TimingEventType.GET_IN => opts.DefaultGetInMinutes,
            TimingEventType.LOAD_IN_VENUE => opts.DefaultLoadInVenueMinutes,
            TimingEventType.LOAD_IN_STAGE => opts.DefaultStageLoadInMinutes,
            TimingEventType.BACKSTAGE_DROP => opts.DefaultBackstageDropMinutes,
            TimingEventType.SETUP_ON_STAGE => opts.DefaultSetupOnStageMinutes,
            TimingEventType.SOUNDCHECK => opts.DefaultSoundcheckMinutes,
            TimingEventType.CHANGEOVER => opts.DefaultChangeoverMinutes,
            TimingEventType.PRESHOW_LINECHECK => opts.DefaultPreShowLinecheckMinutes,
            TimingEventType.ON_STAGE => opts.DefaultSetLengthMinutes,
            TimingEventType.LOAD_OUT_STAGING => opts.DefaultLoadInVenueMinutes,
            TimingEventType.LOAD_OUT_VENUE => opts.DefaultLoadInVenueMinutes,
            TimingEventType.CATERING => 30,
            TimingEventType.BACKSTAGE_WAIT => 15,
            _ => 15,
        };
    }

    private string EventColor(TimingEventType type) => EventColor(type, new RunningOrderSlot());

    private string EventColor(TimingEventType type, RunningOrderSlot slot)
    {
        var inPost = slot.PostShowEvents.Any(e => e.EventType == type);

        return type switch
        {
            TimingEventType.GET_IN => "#17a2b8",
            TimingEventType.LOAD_IN_VENUE => "#4dabf7",
            TimingEventType.LOAD_IN_STAGE => "#007bff",
            TimingEventType.BACKSTAGE_DROP => "#8fbc8f",
            TimingEventType.SETUP_ON_STAGE => "#ffc107",
            TimingEventType.SOUNDCHECK => "#fd7e14",
            TimingEventType.CHANGEOVER => "#ffc107",
            TimingEventType.PRESHOW_LINECHECK => "#ffb347",
            TimingEventType.ON_STAGE => "#dc3545",
            TimingEventType.LOAD_OUT_STAGING or TimingEventType.LOAD_OUT_VENUE => "#007bff",
            TimingEventType.CATERING => "#6f42c1",
            TimingEventType.BACKSTAGE_WAIT => "#6c757d",
            _ => inPost ? "#007bff" : "#ffc107",
        };
    }

    private string FormatTime(DateTime dt, DateTime baseDate)
    {
        var dayOffset = (int)(dt.Date - baseDate.Date).TotalDays;
        var badge = dayOffset > 0 ? $"+{dayOffset}d " : string.Empty;
        return badge + dt.ToString("HH:mm");
    }

    private IEnumerable<(TimingEventType Type, string Label)> LegendItems()
    {
        var opts = Order.VenueOptions ?? new VenueTimingOptions();
        if (opts.IncludeGetIn) yield return (TimingEventType.GET_IN, GetEventLabel(TimingEventType.GET_IN));
        if (opts.IncludeLoadInVenue) yield return (TimingEventType.LOAD_IN_VENUE, GetEventLabel(TimingEventType.LOAD_IN_VENUE));
        if (opts.IncludeBackstageDrop) yield return (TimingEventType.BACKSTAGE_DROP, GetEventLabel(TimingEventType.BACKSTAGE_DROP));
        if (opts.IncludeStageLoadIn) yield return (TimingEventType.LOAD_IN_STAGE, GetEventLabel(TimingEventType.LOAD_IN_STAGE));
        if (opts.IncludeSetupOnStage) yield return (TimingEventType.SETUP_ON_STAGE, GetEventLabel(TimingEventType.SETUP_ON_STAGE));
        if (opts.IncludeSoundcheck) yield return (TimingEventType.SOUNDCHECK, GetEventLabel(TimingEventType.SOUNDCHECK));
        yield return (TimingEventType.CHANGEOVER, GetEventLabel(TimingEventType.CHANGEOVER));
        if (opts.IncludePreShowLinecheck) yield return (TimingEventType.PRESHOW_LINECHECK, GetEventLabel(TimingEventType.PRESHOW_LINECHECK));
        yield return (TimingEventType.ON_STAGE, GetEventLabel(TimingEventType.ON_STAGE));
    }

    private static bool ShowInlineTime(TimingEventType type) =>
        type is TimingEventType.GET_IN or TimingEventType.SOUNDCHECK or TimingEventType.ON_STAGE;

    private int SlotIndex(Guid slotId) => Order.Slots.FindIndex(s => s.Id == slotId);
    private bool CanMoveUp(Guid slotId) => SlotIndex(slotId) > 0;
    private bool CanMoveDown(Guid slotId)
    {
        var idx = SlotIndex(slotId);
        return idx >= 0 && idx < Order.Slots.Count - 1;
    }

    private static IEnumerable<DateTime> RulerHours(DateTime min, DateTime max)
    {
        var start = new DateTime(min.Year, min.Month, min.Day, min.Hour, 0, 0, min.Kind);
        if (start < min) start = start.AddHours(1);
        var end = new DateTime(max.Year, max.Month, max.Day, max.Hour, 0, 0, max.Kind);
        while (start <= end)
        {
            yield return start;
            start = start.AddHours(1);
        }
    }

    private static IEnumerable<DateTime> RulerQuarters(DateTime min, DateTime max)
    {
        var start = new DateTime(min.Year, min.Month, min.Day, min.Hour, (min.Minute / 15 + 1) * 15 % 60, 0, min.Kind);
        if (start < min) start = start.AddMinutes(15);
        if (start.Minute == 0) start = start.AddMinutes(15);
        var end = max;
        while (start <= end)
        {
            if (start.Minute % 60 != 0)
                yield return start;
            start = start.AddMinutes(15);
            if (start.Minute == 0) start = start.AddMinutes(15);
        }
    }
}
