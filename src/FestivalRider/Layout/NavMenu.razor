@using FestivalRider.Components
@implements IDisposable
@inject IBandService BandService
@inject ILocalizationService Localization

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">FestivalRider</a>
        <button title="Navigation menu" class="navbar-toggler" type="button" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="@NavMenuCssClass navbar-collapse">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        @Localization.T("nav.bands")
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="running-order">
                        @Localization.T("nav.runningOrder")
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="bands-v3">
                        @Localization.T("nav.bandsV3")
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="running-order-v3">
                        @Localization.T("nav.runningOrderV3")
                    </NavLink>
                </li>
            </ul>
            <ul class="navbar-nav mb-2 mb-lg-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="export">
                        @Localization.T("nav.export")
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="save">
                        @Localization.T("nav.save")
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="shows">
                        @Localization.T("nav.shows")
                    </NavLink>
                </li>
            </ul>
            <div class="d-flex align-items-center gap-2">
                <ShowPicker Shows="BandService.Shows"
                            ActiveShowId="BandService.ActiveShowId"
                            OnChange="OnShowChanged"
                            Label="@Localization.T("nav.show.label")"
                            UntitledPlaceholder="@Localization.T("nav.show.untitled")" />
                <LocalePicker Locales="Localization.AvailableLocales"
                              CurrentTag="Localization.CurrentLocale"
                              OnChange="OnLocaleChanged" />
            </div>
        </div>
    </div>
</nav>

@code {
    private bool _collapseNavMenu = true;

    private string? NavMenuCssClass => _collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu() => _collapseNavMenu = !_collapseNavMenu;

    protected override void OnInitialized()
    {
        BandService.OnChange += HandleChange;
        Localization.OnLocaleChanged += HandleChange;
    }

    private void HandleChange() => InvokeAsync(StateHasChanged);

    private async Task OnShowChanged(Guid id)
    {
        await BandService.SetActiveShow(id);
    }

    private async Task OnLocaleChanged(string tag)
    {
        await Localization.SetLocaleAsync(tag);
    }

    public void Dispose()
    {
        BandService.OnChange -= HandleChange;
        Localization.OnLocaleChanged -= HandleChange;
    }
}
