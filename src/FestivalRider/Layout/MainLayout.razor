@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject ILocalizationService Localization
@inject IStorageService Storage
@inject IToastService Toasts

<div class="page">
    <NavMenu />

    <main>
        <MultiTabBanner Show="Storage.AnotherTabActive" Message="@Localization.T("banner.multitab")" />
        <article class="content px-2">
            @Body
        </article>
    </main>
</div>

<ToastContainer Toasts="Toasts.Active" OnDismiss="Toasts.Dismiss" />
<UpdateAvailableToast BodyText="@Localization.T("update.body")"
                      ReloadLabel="@Localization.T("update.reload")"
                      DismissLabel="@Localization.T("update.dismiss")" />

@code {
    protected override void OnInitialized()
    {
        Storage.OnAnotherTabChanged += HandleChange;
        Toasts.OnChange += HandleChange;
        Localization.OnLocaleChanged += HandleChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Localization.EnsureLoadedAsync();
            await Storage.EnsureLoadedAsync();
        }
    }

    private void HandleChange() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Storage.OnAnotherTabChanged -= HandleChange;
        Toasts.OnChange -= HandleChange;
        Localization.OnLocaleChanged -= HandleChange;
        await Storage.FlushAsync();
    }
}