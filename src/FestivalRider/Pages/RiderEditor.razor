@page "/band/{Id:guid}"
@implements IDisposable
@inject IBandService BandService
@inject ILocalizationService Localization
@inject IExportService Export
@inject IToastService Toasts
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@(_band?.Name ?? "Band") · FestivalRider</PageTitle>

@if (_band is null)
{
    <div class="alert alert-warning">
        @Localization.T("page.editor.bandNotFound") <a href="/">@Localization.T("page.editor.backToBands")</a>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <a href="/" class="text-decoration-none">@Localization.T("page.editor.backToBands")</a>
            <h1 class="h3 m-0">@_band.Name</h1>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" @onclick="Save">@Localization.T("page.editor.save")</button>
            <button class="btn btn-outline-secondary" @onclick="PrintBand">@Localization.T("page.editor.print")</button>
            <button class="btn btn-outline-secondary" @onclick="ExportCsv">@Localization.T("page.editor.exportCsv")</button>
            <label class="btn btn-outline-secondary mb-0">
                @Localization.T("page.editor.importCsv")
                <InputFile OnChange="ImportCsv" accept=".csv" class="d-none" />
            </label>
            <button class="btn btn-outline-secondary" @onclick="GoBack">@Localization.T("page.editor.back")</button>
        </div>
    </div>

    <EditForm Model="_band" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <RiderSection Title="@Localization.T("section.band.title")">
            <div class="mb-2">
                <label class="form-label">@Localization.T("field.name")</label>
                <InputText class="form-control" @bind-Value="_band.Name" />
            </div>
            <div class="mb-2">
                <label class="form-label">@Localization.T("field.notes")</label>
                <InputTextArea class="form-control" rows="2" @bind-Value="_band.Notes" />
            </div>
        </RiderSection>

        <RiderSection Title="@Localization.T("section.contacts.title")">
            @for (var i = 0; i < _band.Contacts.Count; i++)
            {
                var idx = i;
                var contact = _band.Contacts[idx];
                <div class="row g-2 align-items-end mb-2" @key="idx">
                    <div class="col-md-3">
                        <label class="form-label">@Localization.T("field.role")</label>
                        <InputSelect class="form-select" @bind-Value="contact.Role">
                            @foreach (var r in Enum.GetValues<ContactRole>())
                            {
                                <option value="@r">@Localization.T($"enum.ContactRole.{r}")</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Localization.T("field.name")</label>
                        <InputText class="form-control" @bind-Value="contact.Name" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Localization.T("field.email")</label>
                        <InputText class="form-control" @bind-Value="contact.Email" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">@Localization.T("field.phone")</label>
                        <InputText class="form-control" @bind-Value="contact.Phone" />
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-outline-danger w-100" @onclick="() => _band.Contacts.RemoveAt(idx)">×</button>
                    </div>
                </div>
            }
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => _band.Contacts.Add(new Contact())">@Localization.T("field.contact.addBtn")</button>
        </RiderSection>

        <RiderSection Title="@Localization.T("section.travelParty.title")">
            @for (var i = 0; i < _band.TravelParty.Members.Count; i++)
            {
                var idx = i;
                var party = _band.TravelParty.Members[idx];
                <div class="row g-2 align-items-end mb-2" @key="idx">
                    <div class="col-md-3">
                        <label class="form-label">@Localization.T("field.type")</label>
                        <InputSelect class="form-select" @bind-Value="party.Type">
                            @foreach (var t in Enum.GetValues<PartyType>())
                            {
                                <option value="@t">@Localization.T($"enum.PartyType.{t}")</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localization.T("field.role")</label>
                        <InputText class="form-control" @bind-Value="party.Role" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localization.T("field.name")</label>
                        <InputText class="form-control" @bind-Value="party.Name" />
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-outline-danger w-100" @onclick="() => _band.TravelParty.Members.RemoveAt(idx)">×</button>
                    </div>
                </div>
            }
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => _band.TravelParty.Members.Add(new Party())">@Localization.T("field.travelParty.addBtn")</button>
        </RiderSection>

        <h2 class="h4 mt-4">@Localization.T("page.editor.tech.heading")</h2>

        <RiderSection Title="@Localization.T("section.cabling.title")" InitiallyExpanded="false">
            @for (var i = 0; i < _band.Rider.Tech.Cables.Count; i++)
            {
                var idx = i;
                var cable = _band.Rider.Tech.Cables[idx];
                <div class="border rounded p-2 mb-2" @key="idx">
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label">@Localization.T("field.cable.source")</label>
                            <InputSelect class="form-select" @bind-Value="cable.Source">
                                @foreach (var p in Enum.GetValues<CablePoint>())
                                {
                                    <option value="@p">@Localization.T($"enum.CablePoint.{p}")</option>
                                }
                            </InputSelect>
                        </div>
                        @if (cable.Source == CablePoint.Other)
                        {
                            <div class="col-md-3">
                                <label class="form-label">@Localization.T("field.cable.sourceOther")</label>
                                <InputText class="form-control" @bind-Value="cable.SourceOther" />
                            </div>
                        }
                        <div class="col-md-3">
                            <label class="form-label">@Localization.T("field.cable.target")</label>
                            <InputSelect class="form-select" @bind-Value="cable.Target">
                                @foreach (var p in Enum.GetValues<CablePoint>())
                                {
                                    <option value="@p">@Localization.T($"enum.CablePoint.{p}")</option>
                                }
                            </InputSelect>
                        </div>
                        @if (cable.Target == CablePoint.Other)
                        {
                            <div class="col-md-3">
                                <label class="form-label">@Localization.T("field.cable.targetOther")</label>
                                <InputText class="form-control" @bind-Value="cable.TargetOther" />
                            </div>
                        }
                        <div class="col-md-2">
                            <label class="form-label">@Localization.T("field.type")</label>
                            <InputSelect class="form-select" @bind-Value="cable.Type">
                                @foreach (var t in Enum.GetValues<CableType>())
                                {
                                    <option value="@t">@Localization.T($"enum.CableType.{t}")</option>
                                }
                            </InputSelect>
                        </div>
                        @if (cable.Type == CableType.Other)
                        {
                            <div class="col-md-2">
                                <label class="form-label">@Localization.T("field.cable.typeOther")</label>
                                <InputText class="form-control" @bind-Value="cable.TypeOther" />
                            </div>
                        }
                        <div class="col-md-3">
                            <label class="form-label">@Localization.T("field.spec")</label>
                            <InputText class="form-control" @bind-Value="cable.CategoryOrSpec" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@Localization.T("field.cable.minLength")</label>
                            <InputNumber class="form-control" @bind-Value="cable.MinLengthMeters" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@Localization.T("field.provider")</label>
                            <InputSelect class="form-select" @bind-Value="cable.Provider">
                                @foreach (var p in Enum.GetValues<CableProvider>())
                                {
                                    <option value="@p">@Localization.T($"enum.CableProvider.{p}")</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="button" class="btn btn-outline-danger w-100" @onclick="() => _band.Rider.Tech.Cables.RemoveAt(idx)">×</button>
                        </div>
                    </div>
                </div>
            }
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => _band.Rider.Tech.Cables.Add(new Cable())">@Localization.T("field.cable.addBtn")</button>
        </RiderSection>

        <RiderSection Title="@Localization.T("section.lighting.title")" InitiallyExpanded="false">
            <div class="row g-2 mb-2">
                <div class="col-md-6">
                    <label class="form-label">@Localization.T("field.lighting.ownConsole")</label>
                    <InputText class="form-control" @bind-Value="_band.Rider.Tech.Lighting.OwnConsoleModel" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Localization.T("field.lighting.backdropWidth")</label>
                    <InputNumber class="form-control" @bind-Value="_band.Rider.Tech.Lighting.BackdropWidthMeters" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Localization.T("field.lighting.backdropHeight")</label>
                    <InputNumber class="form-control" @bind-Value="_band.Rider.Tech.Lighting.BackdropHeightMeters" />
                </div>
            </div>
            <h6>@Localization.T("field.lighting.floorMachines")</h6>
            @for (var i = 0; i < _band.Rider.Tech.Lighting.FloorMachines.Count; i++)
            {
                var idx = i;
                var m = _band.Rider.Tech.Lighting.FloorMachines[idx];
                <div class="row g-2 align-items-end mb-2" @key="idx">
                    <div class="col-md-7">
                        <label class="form-label">@Localization.T("field.name")</label>
                        <InputText class="form-control" @bind-Value="m.Name" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Localization.T("field.count")</label>
                        <InputNumber class="form-control" @bind-Value="m.Count" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-outline-danger w-100" @onclick="() => _band.Rider.Tech.Lighting.FloorMachines.RemoveAt(idx)">×</button>
                    </div>
                </div>
            }
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => _band.Rider.Tech.Lighting.FloorMachines.Add(new LightingMachine())">@Localization.T("field.lighting.addMachine")</button>
        </RiderSection>

        <RiderSection Title="@Localization.T("section.power.title")" InitiallyExpanded="false">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label">@Localization.T("field.power.amperage")</label>
                    <InputSelect class="form-select" @bind-Value="_band.Rider.Tech.Power.Amperage">
                        @foreach (var a in Enum.GetValues<PowerAmperage>())
                        {
                            <option value="@a">@Localization.T($"enum.PowerAmperage.{a}")</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Localization.T("field.power.phase")</label>
                    <InputSelect class="form-select" @bind-Value="_band.Rider.Tech.Power.Phase">
                        @foreach (var p in Enum.GetValues<PowerPhase>())
                        {
                            <option value="@p">@Localization.T($"enum.PowerPhase.{p}")</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-6">
                    <label class="form-label">@Localization.T("field.power.adapterNotes")</label>
                    <InputText class="form-control" @bind-Value="_band.Rider.Tech.Power.AdapterNotes" />
                </div>
            </div>
        </RiderSection>

        <RiderSection Title="@Localization.T("section.foh.title")" InitiallyExpanded="false">
            <div class="row g-2 mb-2">
                <div class="col-md-6">
                    <label class="form-label">@Localization.T("field.foh.ownConsole")</label>
                    <InputText class="form-control" @bind-Value="_band.Rider.Tech.Foh.OwnConsoleModel" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Localization.T("field.foh.outputProtocol")</label>
                    <InputSelect class="form-select" @bind-Value="_band.Rider.Tech.Foh.OutputProtocol">
                        @foreach (var p in Enum.GetValues<OutputProtocol>())
                        {
                            <option value="@p">@Localization.T($"enum.OutputProtocol.{p}")</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Localization.T("field.foh.outputLocation")</label>
                    <InputSelect class="form-select" @bind-Value="_band.Rider.Tech.Foh.OutputLocation">
                        @foreach (var l in Enum.GetValues<OutputLocation>())
                        {
                            <option value="@l">@Localization.T($"enum.OutputLocation.{l}")</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-6">
                    <label class="form-label">@Localization.T("field.foh.outputNotes")</label>
                    <InputText class="form-control" @bind-Value="_band.Rider.Tech.Foh.OutputNotes" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@Localization.T("field.foh.additionalHardware")</label>
                    <InputText class="form-control" @bind-Value="_band.Rider.Tech.Foh.AdditionalHardware" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Localization.T("field.foh.stageToFohSends")</label>
                    <InputNumber class="form-control" @bind-Value="_band.Rider.Tech.Foh.StageToFohSendCount" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="_band.Rider.Tech.Foh.StageToFohRoundTrip" />
                        <label class="form-check-label">@Localization.T("field.foh.roundTrip")</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Localization.T("field.foh.footprintWidth")</label>
                    <InputNumber class="form-control" @bind-Value="_band.Rider.Tech.Foh.FootprintWidthMeters" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Localization.T("field.foh.footprintLength")</label>
                    <InputNumber class="form-control" @bind-Value="_band.Rider.Tech.Foh.FootprintLengthMeters" />
                </div>
                <div class="col-12">
                    <label class="form-label">@Localization.T("field.notes")</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_band.Rider.Tech.Foh.Notes" />
                </div>
            </div>
        </RiderSection>

        <RiderSection Title="@Localization.T("section.monitors.title")" InitiallyExpanded="false">
            <div class="row g-2 mb-2">
                <div class="col-md-3">
                    <label class="form-label">@Localization.T("field.monitors.sourceMode")</label>
                    <InputSelect class="form-select" @bind-Value="_band.Rider.Tech.Monitors.SourceMode">
                        @foreach (var m in Enum.GetValues<MonitorSourceMode>())
                        {
                            <option value="@m">@Localization.T($"enum.MonitorSourceMode.{m}")</option>
                        }
                    </InputSelect>
                </div>
                @if (_band.Rider.Tech.Monitors.SourceMode == MonitorSourceMode.OwnConsole)
                {
                    <div class="col-md-5">
                        <label class="form-label">@Localization.T("field.monitors.ownConsole")</label>
                        <InputText class="form-control" @bind-Value="_band.Rider.Tech.Monitors.OwnConsoleModel" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localization.T("field.monitors.consoleLocation")</label>
                        <InputSelect class="form-select" @bind-Value="_band.Rider.Tech.Monitors.OwnConsoleLocation">
                            @foreach (var l in Enum.GetValues<MonitorTechLocation>())
                            {
                                <option value="@l">@Localization.T($"enum.MonitorTechLocation.{l}")</option>
                            }
                        </InputSelect>
                    </div>
                }
            </div>

            <h6>@Localization.T("field.monitors.wedges")</h6>
            @for (var i = 0; i < _band.Rider.Tech.Monitors.Wedges.Count; i++)
            {
                var idx = i;
                var w = _band.Rider.Tech.Monitors.Wedges[idx];
                <div class="row g-2 align-items-end mb-2" @key="idx">
                    <div class="col-md-4">
                        <label class="form-label">@Localization.T("field.where")</label>
                        <InputText class="form-control" @bind-Value="w.Where" />
                    </div>
                    <div class="col-md-2 form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="w.DualLinked" />
                        <label class="form-check-label">@Localization.T("field.monitors.dual")</label>
                    </div>
                    <div class="col-md-2 form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="w.Stereo" />
                        <label class="form-check-label">@Localization.T("field.monitors.stereo")</label>
                    </div>
                    <div class="col-md-2 form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="w.DrumFill" />
                        <label class="form-check-label">@Localization.T("field.monitors.drumfill")</label>
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-outline-danger w-100" @onclick="() => _band.Rider.Tech.Monitors.Wedges.RemoveAt(idx)">×</button>
                    </div>
                </div>
            }
            <button type="button" class="btn btn-sm btn-outline-primary mb-3" @onclick="() => _band.Rider.Tech.Monitors.Wedges.Add(new MonitorWedge())">@Localization.T("field.monitors.addWedge")</button>

            <h6>@Localization.T("field.monitors.inEars")</h6>
            @for (var i = 0; i < _band.Rider.Tech.Monitors.InEars.Count; i++)
            {
                var idx = i;
                var iem = _band.Rider.Tech.Monitors.InEars[idx];
                <div class="row g-2 align-items-end mb-2" @key="idx">
                    <div class="col-md-3">
                        <label class="form-label">@Localization.T("field.where")</label>
                        <InputText class="form-control" @bind-Value="iem.Where" />
                    </div>
                    <div class="col-md-2 form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="iem.IsWireless" />
                        <label class="form-check-label">@Localization.T("field.monitors.wireless")</label>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">@Localization.T("field.provider")</label>
                        <InputSelect class="form-select" @bind-Value="iem.Provider">
                            @foreach (var p in Enum.GetValues<CableProvider>())
                            {
                                <option value="@p">@Localization.T($"enum.CableProvider.{p}")</option>
                            }
                        </InputSelect>
                    </div>
                    @if (iem.IsWireless && iem.Provider == CableProvider.Brought)
                    {
                        <div class="col-md-2">
                            <label class="form-label">@Localization.T("field.model")</label>
                            <InputText class="form-control" @bind-Value="iem.Model" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@Localization.T("field.frequency")</label>
                            <InputText class="form-control" @bind-Value="iem.Frequency" />
                        </div>
                    }
                    <div class="col-md-1">
                        <button type="button" class="btn btn-outline-danger w-100" @onclick="() => _band.Rider.Tech.Monitors.InEars.RemoveAt(idx)">×</button>
                    </div>
                </div>
            }
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => _band.Rider.Tech.Monitors.InEars.Add(new InEarMonitor())">@Localization.T("field.monitors.addIem")</button>

            <div class="mt-3">
                <label class="form-label">@Localization.T("field.notes")</label>
                <InputTextArea class="form-control" rows="2" @bind-Value="_band.Rider.Tech.Monitors.Notes" />
            </div>
        </RiderSection>

        <RiderSection Title="@Localization.T("section.stage.title")" InitiallyExpanded="false">
            <h6>@Localization.T("field.stage.risers")</h6>
            @for (var i = 0; i < _band.Rider.Tech.Stage.Risers.Count; i++)
            {
                var idx = i;
                var r = _band.Rider.Tech.Stage.Risers[idx];
                <div class="row g-2 align-items-end mb-2" @key="idx">
                    <div class="col-md-3">
                        <label class="form-label">@Localization.T("field.where")</label>
                        <InputText class="form-control" @bind-Value="r.Where" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">@Localization.T("field.stage.riserWidth")</label>
                        <InputNumber class="form-control" @bind-Value="r.WidthMeters" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">@Localization.T("field.stage.riserLength")</label>
                        <InputNumber class="form-control" @bind-Value="r.LengthMeters" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">@Localization.T("field.stage.riserHeight")</label>
                        <InputNumber class="form-control" @bind-Value="r.HeightCm" />
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-outline-danger w-100" @onclick="() => _band.Rider.Tech.Stage.Risers.RemoveAt(idx)">×</button>
                    </div>
                </div>
            }
            <button type="button" class="btn btn-sm btn-outline-primary mb-3" @onclick="() => _band.Rider.Tech.Stage.Risers.Add(new Riser())">@Localization.T("field.stage.addRiser")</button>

            <h6>@Localization.T("field.stage.otherRisers")</h6>
            @for (var i = 0; i < _band.Rider.Tech.Stage.OtherRisers.Count; i++)
            {
                var idx = i;
                var o = _band.Rider.Tech.Stage.OtherRisers[idx];
                <div class="row g-2 align-items-end mb-2" @key="idx">
                    <div class="col-md-4">
                        <label class="form-label">@Localization.T("field.where")</label>
                        <InputText class="form-control" @bind-Value="o.Where" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Localization.T("field.type")</label>
                        <InputSelect class="form-select" @bind-Value="o.Type">
                            @foreach (var t in Enum.GetValues<OtherRiserType>())
                            {
                                <option value="@t">@Localization.T($"enum.OtherRiserType.{t}")</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localization.T("field.description")</label>
                        <InputText class="form-control" @bind-Value="o.Description" />
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-outline-danger w-100" @onclick="() => _band.Rider.Tech.Stage.OtherRisers.RemoveAt(idx)">×</button>
                    </div>
                </div>
            }
            <button type="button" class="btn btn-sm btn-outline-primary mb-3" @onclick="() => _band.Rider.Tech.Stage.OtherRisers.Add(new OtherRiser())">@Localization.T("field.stage.addOtherRiser")</button>

            <h6>@Localization.T("field.stage.wirelessMics")</h6>
            @for (var i = 0; i < _band.Rider.Tech.Stage.WirelessMics.Count; i++)
            {
                var idx = i;
                var w = _band.Rider.Tech.Stage.WirelessMics[idx];
                <div class="row g-2 align-items-end mb-2" @key="idx">
                    <div class="col-md-3">
                        <label class="form-label">@Localization.T("field.where")</label>
                        <InputText class="form-control" @bind-Value="w.Where" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">@Localization.T("field.count")</label>
                        <InputNumber class="form-control" @bind-Value="w.Count" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">@Localization.T("field.provider")</label>
                        <InputSelect class="form-select" @bind-Value="w.Provider">
                            @foreach (var p in Enum.GetValues<CableProvider>())
                            {
                                <option value="@p">@Localization.T($"enum.CableProvider.{p}")</option>
                            }
                        </InputSelect>
                    </div>
                    @if (w.Provider == CableProvider.Brought)
                    {
                        <div class="col-md-2">
                            <label class="form-label">@Localization.T("field.model")</label>
                            <InputText class="form-control" @bind-Value="w.Model" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@Localization.T("field.frequency")</label>
                            <InputText class="form-control" @bind-Value="w.Frequency" />
                        </div>
                    }
                    <div class="col-md-1">
                        <button type="button" class="btn btn-outline-danger w-100" @onclick="() => _band.Rider.Tech.Stage.WirelessMics.RemoveAt(idx)">×</button>
                    </div>
                </div>
            }
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => _band.Rider.Tech.Stage.WirelessMics.Add(new WirelessMic())">@Localization.T("field.stage.addWirelessMic")</button>

            <div class="form-check mt-3">
                <InputCheckbox class="form-check-input" @bind-Value="_band.Rider.Tech.Stage.BringsOwnMics" />
                <label class="form-check-label">@Localization.T("field.stage.bringsOwnMics")</label>
            </div>
            <div class="mt-2">
                <label class="form-label">@Localization.T("field.notes")</label>
                <InputTextArea class="form-control" rows="2" @bind-Value="_band.Rider.Tech.Stage.Notes" />
            </div>
        </RiderSection>

        <RiderSection Title="@Localization.T("section.techNotes.title")" InitiallyExpanded="false">
            <InputTextArea class="form-control" rows="3" @bind-Value="_band.Rider.Tech.Notes" />
        </RiderSection>

        <h2 class="h4 mt-4">@Localization.T("page.editor.hospitality.heading")</h2>
        <RiderSection Title="@Localization.T("section.hospitality.title")" InitiallyExpanded="false">
            <div class="row g-2 mb-2">
                <div class="col-md-6">
                    <label class="form-label">@Localization.T("field.hospitality.dressingRoom")</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_band.Rider.Hospitality.DressingRoomNotes" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@Localization.T("field.hospitality.catering")</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_band.Rider.Hospitality.CateringNotes" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@Localization.T("field.hospitality.dietaryRestrictions")</label>
                    <InputText class="form-control" @bind-Value="_band.Rider.Hospitality.DietaryRestrictions" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Localization.T("field.hospitality.towelCount")</label>
                    <InputNumber class="form-control" @bind-Value="_band.Rider.Hospitality.TowelCount" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Localization.T("field.hospitality.parkingSpaces")</label>
                    <InputNumber class="form-control" @bind-Value="_band.Rider.Hospitality.ParkingSpaces" />
                </div>
                <div class="col-12">
                    <label class="form-label">@Localization.T("field.hospitality.accommodations")</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_band.Rider.Hospitality.Accommodations" />
                </div>
            </div>
            <h6>@Localization.T("field.hospitality.drinks")</h6>
            @for (var i = 0; i < _band.Rider.Hospitality.DrinksRequests.Count; i++)
            {
                var idx = i;
                <div class="row g-2 align-items-end mb-2" @key="idx">
                    <div class="col-md-10">
                        <input class="form-control" value="@_band.Rider.Hospitality.DrinksRequests[idx]"
                               @oninput="e => _band.Rider.Hospitality.DrinksRequests[idx] = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-outline-danger w-100" @onclick="() => _band.Rider.Hospitality.DrinksRequests.RemoveAt(idx)">×</button>
                    </div>
                </div>
            }
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => _band.Rider.Hospitality.DrinksRequests.Add(string.Empty)">@Localization.T("field.hospitality.addDrink")</button>
        </RiderSection>

        <div class="d-flex justify-content-end gap-2 my-3">
            <button type="button" class="btn btn-outline-secondary" @onclick="GoBack">@Localization.T("page.editor.back")</button>
            <button type="submit" class="btn btn-primary">@Localization.T("page.editor.save")</button>
        </div>
    </EditForm>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Band? _band;

    protected override void OnInitialized()
    {
        BandService.OnChange += HandleChange;
        Localization.OnLocaleChanged += HandleChange;
        Load();
    }

    protected override void OnParametersSet() => Load();

    private void Load() => _band = BandService.FindBand(Id);

    private void HandleChange() => InvokeAsync(StateHasChanged);

    private void Save()
    {
        if (_band is null) return;
        BandService.UpdateBand(_band);
    }

    private async Task ExportCsv()
    {
        if (_band is null) return;
        var csv = Export.ExportBandCsv(_band);
        var safe = new string((_band.Name ?? "band").Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray()).Trim('-');
        if (string.IsNullOrEmpty(safe)) safe = "band";
        await JS.InvokeVoidAsync("festivalRiderCsv.downloadText", $"band-{safe}.csv", "text/csv;charset=utf-8", csv);
    }

    private async Task ImportCsv(InputFileChangeEventArgs e)
    {
        if (_band is null) return;
        try
        {
            await using var s = e.File.OpenReadStream(5 * 1024 * 1024);
            using var reader = new StreamReader(s);
            var csv = await reader.ReadToEndAsync();
            var imported = Export.ImportBandCsv(csv);
            // Preserve the route's band id so the page stays on the same record.
            imported.Id = _band.Id;
            imported.UpdatedAt = DateTimeOffset.UtcNow;
            BandService.UpdateBand(imported);
            _band = BandService.FindBand(_band.Id);
            Toasts.Show(Localization.T("toast.editor.imported", imported.Name), ToastLevel.Success);
        }
        catch (Exception ex)
        {
            Toasts.Show(Localization.T("toast.editor.importFailed", ex.Message), ToastLevel.Error);
        }
    }

    private void GoBack() => Nav.NavigateTo("/");

    private void PrintBand()
    {
        if (_band is null) return;
        Nav.NavigateTo($"/print/band/{_band.Id}");
    }

    public void Dispose()
    {
        BandService.OnChange -= HandleChange;
        Localization.OnLocaleChanged -= HandleChange;
    }
}
