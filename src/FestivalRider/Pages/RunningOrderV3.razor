@page "/running-order-v3"
@using RoModel = FestivalRider.Models.RunningOrder
@using FestivalRider.Components
@implements IDisposable

<style>
    .fr-inline-edit {
        border: none; background: transparent; outline: none;
        padding: 0; margin: 0; font-size: 13px; line-height: 1; height: 13px;
        text-align: center; min-width: 36px; width: auto; color: inherit; font-weight: 700;
        -webkit-appearance: none; -moz-appearance: textfield; appearance: none; box-sizing: content-box;
    }
    /* Time picker indicator is now visible for easier editing */
    .fr-inline-edit::-webkit-inner-spin-button, .fr-inline-edit::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
    .fr-inline-edit::-webkit-datetime-edit { padding: 0; }
    .fr-inline-edit::-webkit-datetime-edit-fields-wrapper { padding: 0; }
    .fr-inline-edit[type="time"] { min-width: 48px; }
</style>
@using FestivalRider.Models
@using FestivalRider.Services
@using Microsoft.AspNetCore.Components.Web
@inject IBandService BandService
@inject ILocalizationService Localization
@inject IToastService Toasts
@inject IRunningOrderScheduler Scheduler
@inject NavigationManager Nav

<PageTitle>@Localization.T("page.runningOrder.title")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="h4 m-0">@Localization.T("page.runningOrder.heading") v3</h1>
    <button class="btn btn-primary btn-sm" @onclick="() => _showCreateModal = true">@Localization.T("page.runningOrder.addBtn")</button>
</div>

@if (BandService.Bands.Count == 0)
{
    <div class="alert alert-warning py-2 small">@Localization.T("page.runningOrder.noBands")</div>
}

<RiderSection Title="@Localization.T(LocalizationKeys.Page.RunningOrder.VenueDefaults.SectionTitle)">
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @VenueTimeChip("venue-open", "🟢", Localization.T(LocalizationKeys.Page.RunningOrder.Toolbar.VenueOpenLabel), _show.VenueOpenTime, v => _show.VenueOpenTime = v)
        @VenueTimeChip("venue-close", "🔴", Localization.T(LocalizationKeys.Page.RunningOrder.Toolbar.VenueCloseLabel), _show.VenueCloseTime, v => _show.VenueCloseTime = v)
        @VenueTimeChip("tech-getin", "🔧", Localization.T(LocalizationKeys.Page.RunningOrder.Toolbar.TechnicalGetInLabel), _show.TechnicalGetInTime, v => _show.TechnicalGetInTime = v)
        @VenueTimeChip("doors", "🚪", Localization.T(LocalizationKeys.Page.RunningOrder.Toolbar.DoorsLabel), _show.DoorsOpeningTime, v => _show.DoorsOpeningTime = v)
        @VenueTimeChip("first-show", "🎤", Localization.T(LocalizationKeys.Page.RunningOrder.Toolbar.FirstShowLabel), _show.FirstShowTime, v => _show.FirstShowTime = v)
        @VenueTimeChip("sound-curfew", "🔇", Localization.T(LocalizationKeys.Page.RunningOrder.Toolbar.SoundCurfewLabel), _show.SoundCurfewTime, v => _show.SoundCurfewTime = v)
        @VenueTimeChip("backstage-curfew", "🚫", Localization.T(LocalizationKeys.Page.RunningOrder.Toolbar.BackstageCurfewLabel), _show.BackstageCurfewTime, v => _show.BackstageCurfewTime = v)
        <button class="btn btn-sm btn-primary ms-2" @onclick="SaveVenueDefaults">@Localization.T(LocalizationKeys.Page.RunningOrder.VenueDefaults.SaveBtn)</button>
    </div>
</RiderSection>

@if (!BandService.RunningOrdersForActiveShow.Any())
{
    <div class="alert alert-info py-2 small">@Localization.T("page.runningOrder.empty", Localization.T("page.runningOrder.addBtn"))</div>
}
else
{
    @foreach (var order in BandService.RunningOrdersForActiveShow.OrderBy(o => o.ShowDayNumber))
    {
        <RiderSection Title="@TitleFor(order)">
            @{ var ro = order; }
            <RunningOrderEditor Order="ro" Show="_show" Bands="BandService.Bands" Stages="_show.Stages"
                                GetEventLabel="GetEventLabel" GetModeLabel="GetModeLabel"
                                DayNumberLabel="@Localization.T("page.runningOrder.dayLabel")"
                                ShowDayCount="@_show.ShowDayCount"
                                DeleteBtnLabel="@Localization.T("page.runningOrder.deleteBtn")"
                                ScheduleOptionsBtnLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.ScheduleOptions.Title)"
                                ScheduleOptionsTitle="@Localization.T(LocalizationKeys.Page.RunningOrder.ScheduleOptions.Title)"
                                ModeLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.ScheduleOptions.ModeLabel)"
                                AnchorLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.ScheduleOptions.AnchorLabel)"
                                DefaultLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.ScheduleOptions.DefaultLabel)"
                                TemplateTitle="@Localization.T(LocalizationKeys.Page.RunningOrder.ScheduleOptions.TemplateHeading)"
                                PresetFestivalMainStage="@Localization.T(LocalizationKeys.Page.RunningOrder.Template.Preset.FestivalMainStage)"
                                PresetFestivalTent="@Localization.T(LocalizationKeys.Page.RunningOrder.Template.Preset.FestivalTent)"
                                PresetTraditionalVenue="@Localization.T(LocalizationKeys.Page.RunningOrder.Template.Preset.TraditionalVenue)"
                                DefaultSetLengthLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.VenueOptions.DefaultSetLengthMinutes)"
                                EarlyChainLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.Panel.EarlyChainHeading)"
                                PreShowLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.Panel.PreShowHeading)"
                                PostShowLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.Panel.PostShowHeading)"
                                CloseLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.ScheduleOptions.CloseLabel)"
                                CancelLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.ScheduleOptions.CancelLabel)"
                                ModeChangeConfirmTitle="@Localization.T(LocalizationKeys.Page.RunningOrder.ScheduleOptions.ModeChangeConfirmTitle)"
                                ModeChangeConfirmMessage="@Localization.T(LocalizationKeys.Page.RunningOrder.ScheduleOptions.ModeChangeConfirmMessage)"
                                ModeChangeConfirmLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.ScheduleOptions.ModeChangeConfirmLabel)"
                                OnDayChanged="e => OnDayChanged(ro, e)"
                                OnDeleteRequest="() => RequestDelete(ro.Id)"
                                OnChange="() => OnOrderChanged(ro)" />
        </RiderSection>
    }
}

<CreateRunningOrderModal @bind-Visible="_showCreateModal"
                        OnCreate="OnCreateRunningOrder"
                        GetEventLabel="GetEventLabel"
                        Title="@Localization.T(LocalizationKeys.Page.RunningOrder.Create.Title)"
                        PickModeHint="@Localization.T(LocalizationKeys.Page.RunningOrder.Create.PickModeHint)"
                        FestivalModeLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.Create.FestivalModeLabel)"
                        FestivalModeHint="@Localization.T(LocalizationKeys.Page.RunningOrder.Create.FestivalModeHint)"
                        VenueModeLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.Create.VenueModeLabel)"
                        VenueModeHint="@Localization.T(LocalizationKeys.Page.RunningOrder.Create.VenueModeHint)"
                        BackLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.Create.BackLabel)"
                        FestivalTemplateHint="@Localization.T(LocalizationKeys.Page.RunningOrder.Create.FestivalTemplateHint)"
                        DefaultTemplateLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.Create.DefaultTemplateLabel)"
                        DefaultTemplateHint="@Localization.T(LocalizationKeys.Page.RunningOrder.Create.DefaultTemplateHint)"
                        CustomTemplateLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.Create.CustomTemplateLabel)"
                        CustomTemplateHint="@Localization.T(LocalizationKeys.Page.RunningOrder.Create.CustomTemplateHint)"
                        DefaultSetLengthLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.VenueOptions.DefaultSetLengthMinutes)"
                        PresetFestivalMainStage="@Localization.T(LocalizationKeys.Page.RunningOrder.Template.Preset.FestivalMainStage)"
                        PresetFestivalTent="@Localization.T(LocalizationKeys.Page.RunningOrder.Template.Preset.FestivalTent)"
                        PresetTraditionalVenue="@Localization.T(LocalizationKeys.Page.RunningOrder.Template.Preset.TraditionalVenue)"
                        AddEntryBtn="@Localization.T(LocalizationKeys.Page.RunningOrder.Template.AddEntryBtn)"
                        CancelLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.Create.CancelLabel)"
                        CreateLabel="@Localization.T(LocalizationKeys.Page.RunningOrder.Create.CreateLabel)" />

<ConfirmDialog Show="_pendingDeleteId.HasValue"
               Title="@Localization.T("confirm.deleteRunningOrder.title")"
               Message="@_deleteMessage"
               ConfirmLabel="@Localization.T("confirm.deleteRunningOrder.label")"
               OnConfirm="ConfirmDelete"
               OnCancel="() => _pendingDeleteId = null" />

@code {
    private ShowData _show = new();
    private bool _showCreateModal;
    private Guid? _pendingDeleteId;
    private string _deleteMessage = string.Empty;

    protected override void OnInitialized()
    {
        BandService.OnChange += HandleChange;
        Localization.OnLocaleChanged += HandleChange;
        Reload();
        foreach (var ro in BandService.RunningOrdersForActiveShow.ToList())
        {
            Scheduler.Recalculate(ro, _show);
            BandService.UpdateRunningOrder(ro);
        }
    }

    private void HandleChange()
    {
        Reload();
        InvokeAsync(StateHasChanged);
    }

    private void Reload()
    {
        _show = BandService.FindShow(BandService.ActiveShowId) ?? new ShowData();
    }

    private string TitleFor(RoModel ro)
    {
        var date = FormatDate(ro);
        return string.IsNullOrEmpty(date)
            ? Localization.T("page.runningOrder.dayTitle.noDate", ro.ShowDayNumber, ro.Slots.Count)
            : Localization.T("page.runningOrder.dayTitle", ro.ShowDayNumber, date, ro.Slots.Count);
    }

    private string FormatDate(RoModel ro)
    {
        if (_show.DateOfOpening == default) return string.Empty;
        var date = _show.DateOfOpening.AddDays(ro.ShowDayNumber - 1);
        return date.ToString("ddd dd MMM yyyy");
    }

    private void OnCreateRunningOrder((ScheduleMode Mode, FestivalTimingTemplate? Template) args)
    {
        var scoped = BandService.RunningOrdersForActiveShow.ToList();
        var nextDay = scoped.Count == 0
            ? 1
            : Math.Min(_show.ShowDayCount, scoped.Max(o => o.ShowDayNumber) + 1);
        var ro = new RoModel
        {
            ShowId = BandService.ActiveShowId,
            ShowDayNumber = Math.Max(1, nextDay),
            ModeOverride = args.Mode,
            FestivalTemplate = args.Template,
        };
        BandService.AddRunningOrder(ro);
        Scheduler.Recalculate(ro, _show);
        BandService.UpdateRunningOrder(ro);
    }

    private void ConfirmDelete()
    {
        if (_pendingDeleteId is { } id)
        {
            BandService.DeleteRunningOrder(id);
            Toasts.Show(Localization.T(LocalizationKeys.Toast.RunningOrder.Deleted), ToastLevel.Info);
        }
        _pendingDeleteId = null;
    }

    private void RequestDelete(Guid id)
    {
        var ro = BandService.FindRunningOrder(id);
        _pendingDeleteId = id;
        _deleteMessage = ro is null
            ? Localization.T("confirm.deleteRunningOrder.messageFallback")
            : Localization.T("confirm.deleteRunningOrder.message", ro.ShowDayNumber, ro.Slots.Count);
    }

    private void OnDayChanged(RunningOrder ro, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var v))
        {
            if (v < 1) v = 1;
            if (v > _show.ShowDayCount) v = _show.ShowDayCount;
            ro.ShowDayNumber = v;
            OnOrderChanged(ro);
        }
    }

    private void OnOrderChanged(RunningOrder ro)
    {
        var result = Scheduler.Recalculate(ro, _show);
        BandService.UpdateRunningOrder(ro);
        Toasts.Show(Localization.T(LocalizationKeys.Toast.Schedule.Updated), ToastLevel.Info);
        foreach (var w in result.Warnings)
        {
            var bandName = w.SlotId is { } sid
                ? (ro.Slots.FirstOrDefault(s => s.Id == sid) is { } slot
                    ? (BandService.FindBand(slot.BandId)?.Name ?? "?")
                    : "?")
                : "?";
            Toasts.Show(Localization.T("toast.schedule.warning", w.Message, bandName), ToastLevel.Warning);
        }
    }

    private string GetEventLabel(TimingEventType t) => Localization.T($"enum.TimingEventType.{t}");
    private string GetModeLabel(ScheduleMode m) => Localization.T($"enum.ScheduleMode.{m}");

    private void SaveVenueDefaults()
    {
        BandService.UpdateShow(_show);
        Toasts.Show(Localization.T(LocalizationKeys.Toast.Settings.ShowDetailsSaved), ToastLevel.Success);
    }

    private string? _editingVenueChipKey;
    private ElementReference _venueChipInputRef;
    private bool _focusVenueChipPending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusVenueChipPending)
        {
            _focusVenueChipPending = false;
            try { await _venueChipInputRef.FocusAsync(); } catch { }
        }
    }

    private void StartEditingVenueChip(string key)
    {
        _editingVenueChipKey = key;
        _focusVenueChipPending = true;
    }

    private void HandleVenueChipKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _editingVenueChipKey = null;
    }

    private RenderFragment VenueTimeChip(string key, string icon, string label, DateTime? value, Action<DateTime?> onChange) => __builder =>
    {
        var timeStr = value?.ToString("HH:mm") ?? string.Empty;
        var dayOffset = value.HasValue ? (int)(value.Value.Date - DateTime.Today).TotalDays : 0;
        var isEditing = _editingVenueChipKey == key;
        <span class="d-inline-flex align-items-center gap-1 rounded-pill border px-2 py-1"
              style="background:#e9ecef; border-color: rgba(0,0,0,0.12) !important; font-size:13px; white-space:nowrap; overflow:visible;">
            <span>@icon</span>
            <span class="text-muted fw-semibold">@label</span>
            <span style="width:4px;"></span>
            <input type="time" class="fr-inline-edit fw-bold text-dark"
                   style="min-width:36px; text-align:center; cursor:pointer; line-height:1;"
                   value="@timeStr"
                   @onchange="e => {
                       if (e.Value is string s && TimeOnly.TryParse(s, out var t))
                           onChange(DateTime.Today.AddDays(dayOffset).Add(t.ToTimeSpan()));
                       else
                           onChange(null);
                   }" />
            <span class="text-muted" style="font-size:10px;margin:0 2px;">·</span>
            <button type="button" class="btn btn-link p-0 text-muted lh-1"
                    style="font-size:13px; text-decoration:none; min-width:16px;"
                    @onclick="() => { if (value.HasValue) onChange(value.Value.AddMinutes(-15)); }"
                    disabled="@(!value.HasValue)">−</button>
            <button type="button" class="btn btn-link p-0 text-muted lh-1"
                    style="font-size:13px; text-decoration:none; min-width:16px;"
                    @onclick="() => { if (value.HasValue) onChange(value.Value.AddMinutes(15)); }"
                    disabled="@(!value.HasValue)">+</button>
            @if (dayOffset > 0)
            {
                <span class="badge bg-secondary" style="font-size:9px; padding:2px 5px;">+@dayOffset d</span>
            }
        </span>
    };

    public void Dispose()
    {
        BandService.OnChange -= HandleChange;
        Localization.OnLocaleChanged -= HandleChange;
    }
}
