@page "/shows"
@using System.Globalization
@implements IDisposable
@inject IBandService BandService
@inject ILocalizationService Localization
@inject IStorageService Storage
@inject IToastService Toasts
@inject IBundleService Bundle
@inject IExportService Export
@inject IJSRuntime JS

<PageTitle>@Localization.T("page.shows.title")</PageTitle>

<h1 class="h3 mb-3">@Localization.T("page.shows.heading")</h1>

<RiderSection Title="@Localization.T("section.shows.title")">
    <p class="text-muted small">@Localization.T("page.settings.shows.description")</p>
    @if (BandService.Shows.Count == 0)
    {
        <div class="text-muted small mb-2">@Localization.T("page.settings.shows.noShows")</div>
    }
    else
    {
        <ul class="list-group mb-2">
            @foreach (var s in BandService.Shows)
            {
                var sid = s.Id;
                <li class="list-group-item d-flex justify-content-between align-items-center" @key="sid">
                    <div class="flex-grow-1 me-2">
                        <InputText class="form-control form-control-sm"
                                   @bind-Value="s.Name"
                                   @bind-Value:after="() => RenameShow(s)" />
                    </div>
                    <div class="btn-group btn-group-sm">
                        @if (BandService.ActiveShowId == sid)
                        {
                            <button type="button" class="btn btn-primary" disabled>@Localization.T("page.settings.shows.active")</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-primary"
                                    @onclick="() => SetActiveShow(sid)">@Localization.T("page.settings.shows.setActive")</button>
                        }
                        <button type="button" class="btn btn-outline-primary"
                                @onclick="() => ExportShow(s)">@Localization.T("page.shows.exportShow")</button>
                        <button type="button" class="btn btn-outline-danger"
                                @onclick="() => RequestDeleteShow(sid)">@Localization.T("page.settings.shows.delete")</button>
                    </div>
                </li>
            }
        </ul>
    }
    <div class="row g-2 align-items-end">
        <div class="col-md-9">
            <input class="form-control" placeholder="@Localization.T("page.settings.shows.namePlaceholder")" @bind="_newShowName" />
        </div>
        <div class="col-md-3">
            <button type="button" class="btn btn-outline-primary w-100" @onclick="AddShow">@Localization.T("page.settings.shows.addBtn")</button>
        </div>
    </div>
</RiderSection>

<RiderSection Title="@Localization.T("section.showDetails.title")">
    <EditForm Model="_show" OnValidSubmit="SaveShow">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <label class="form-label">@Localization.T("field.name")</label>
                <InputText class="form-control" @bind-Value="_show.Name" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localization.T("page.settings.showDetails.address")</label>
                <InputText class="form-control" @bind-Value="_show.Address" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@Localization.T("page.settings.showDetails.dateOfOpening")</label>
                <InputDate class="form-control" @bind-Value="_dateOfOpening" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@Localization.T("page.settings.showDetails.showDayCount")</label>
                <InputNumber class="form-control" @bind-Value="_show.ShowDayCount" />
            </div>
        </div>

        <h6>@Localization.T("page.settings.showDetails.stages")</h6>
        @if (_show.Stages.Count == 0)
        {
            <div class="text-muted small mb-2">@Localization.T("page.settings.showDetails.noStages")</div>
        }
        else
        {
            @for (var i = 0; i < _show.Stages.Count; i++)
            {
                var idx = i;
                var s = _show.Stages[idx];
                <div class="row g-2 align-items-end mb-2" @key="s.Id">
                    <div class="col-md-1"><span class="badge bg-secondary">#@s.Id</span></div>
                    <div class="col-md-8">
                        <InputText class="form-control" @bind-Value="s.Name" />
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-outline-danger w-100"
                                @onclick="() => RequestDeleteStage(s.Id)">@Localization.T("page.settings.shows.delete")</button>
                    </div>
                </div>
            }
        }
        <div class="row g-2 align-items-end mb-2">
            <div class="col-md-9">
                <input class="form-control" placeholder="@Localization.T("page.settings.showDetails.newStagePlaceholder")" @bind="_newStageName" />
            </div>
            <div class="col-md-3">
                <button type="button" class="btn btn-outline-primary w-100" @onclick="AddStage">@Localization.T("page.settings.showDetails.addStageBtn")</button>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">@Localization.T("page.settings.showDetails.saveBtn")</button>
    </EditForm>
</RiderSection>

<div class="border border-danger rounded p-1">
    <RiderSection Title="@Localization.T("section.dangerZone.title")" InitiallyExpanded="false">
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-primary" @onclick="ForceSave">@Localization.T("page.dangerZone.forceSave")</button>
            <button type="button" class="btn btn-outline-danger" @onclick="() => _confirmClear = true">@Localization.T("page.dangerZone.clearAll")</button>
        </div>
    </RiderSection>
</div>

<ConfirmDialog Show="_confirmClear"
               Title="@Localization.T("confirm.clearData.title")"
               Message="@Localization.T("confirm.clearData.message")"
               ConfirmLabel="@Localization.T("confirm.clearData.label")"
               OnConfirm="ConfirmClear"
               OnCancel="() => _confirmClear = false" />

<ConfirmDialog Show="_pendingDeleteStageId.HasValue"
               Title="@Localization.T("confirm.deleteStage.title")"
               Message="@_deleteStageMessage"
               ConfirmLabel="@Localization.T("confirm.deleteStage.label")"
               OnConfirm="ConfirmDeleteStage"
               OnCancel="() => _pendingDeleteStageId = null" />

<ConfirmDialog Show="_pendingDeleteShowId.HasValue"
               Title="@Localization.T("confirm.deleteShow.title")"
               Message="@_deleteShowMessage"
               ConfirmLabel="@Localization.T("confirm.deleteShow.label")"
               OnConfirm="ConfirmDeleteShow"
               OnCancel="() => _pendingDeleteShowId = null" />

@code {
    private ShowData _show = new();
    private DateTime _dateOfOpening = DateTime.Today;
    private string _newStageName = string.Empty;
    private string _newShowName = string.Empty;
    private bool _confirmClear;
    private int? _pendingDeleteStageId;
    private string _deleteStageMessage = string.Empty;
    private Guid? _pendingDeleteShowId;
    private string _deleteShowMessage = string.Empty;

    protected override void OnInitialized()
    {
        BandService.OnChange += HandleChange;
        Localization.OnLocaleChanged += HandleChange;
        Reload();
    }

    private void HandleChange()
    {
        Reload();
        InvokeAsync(StateHasChanged);
    }

    private void Reload()
    {
        _show = BandService.FindShow(BandService.ActiveShowId) ?? BandService.Shows.FirstOrDefault() ?? new ShowData();
        _dateOfOpening = _show.DateOfOpening == default
            ? DateTime.Today
            : _show.DateOfOpening.ToDateTime(TimeOnly.MinValue);
    }

    private async Task SaveShow()
    {
        _show.DateOfOpening = DateOnly.FromDateTime(_dateOfOpening);
        await BandService.UpdateShow(_show);
        Toasts.Show(Localization.T("toast.settings.showDetailsSaved"), ToastLevel.Success);
    }

    private void AddStage()
    {
        var name = _newStageName.Trim();
        if (string.IsNullOrEmpty(name)) return;
        var id = BandService.AddStage(name);
        _newStageName = string.Empty;
        Toasts.Show(Localization.T("toast.settings.stageAdded", name, id), ToastLevel.Success);
    }

    private void RequestDeleteStage(int id)
    {
        var stage = BandService.FindStage(id);
        _pendingDeleteStageId = id;
        _deleteStageMessage = Localization.T("confirm.deleteStage.message", stage?.Name ?? id.ToString());
    }

    private void ConfirmDeleteStage()
    {
        if (_pendingDeleteStageId is { } id)
        {
            BandService.DeleteStage(id);
            Toasts.Show(Localization.T("toast.settings.stageDeleted"), ToastLevel.Info);
        }
        _pendingDeleteStageId = null;
    }

    private void AddShow()
    {
        var name = _newShowName.Trim();
        if (string.IsNullOrEmpty(name)) return;
        var id = BandService.AddShow(name);
        _newShowName = string.Empty;
        Toasts.Show(Localization.T("toast.settings.showAdded", name), ToastLevel.Success);
        _ = BandService.SetActiveShow(id);
    }

    private async Task SetActiveShow(Guid id)
    {
        await BandService.SetActiveShow(id);
    }

    private async Task RenameShow(ShowData show)
    {
        await BandService.UpdateShow(show);
    }

    private void RequestDeleteShow(Guid id)
    {
        var show = BandService.FindShow(id);
        var roCount = show?.RunningOrders.Count ?? 0;
        _pendingDeleteShowId = id;
        _deleteShowMessage = roCount == 0
            ? Localization.T("confirm.deleteShow.message", show?.Name ?? id.ToString())
            : Localization.T("confirm.deleteShow.messageWithRo", show?.Name ?? id.ToString(), roCount);
    }

    private async Task ConfirmDeleteShow()
    {
        if (_pendingDeleteShowId is { } id)
        {
            var show = BandService.FindShow(id);
            if (show is not null)
            {
                foreach (var ro in show.RunningOrders.Select(o => o.Id).ToList())
                    BandService.DeleteRunningOrder(ro);
            }
            await BandService.DeleteShow(id);
            Toasts.Show(Localization.T("toast.settings.showDeleted"), ToastLevel.Info);
        }
        _pendingDeleteShowId = null;
    }

    private async Task ForceSave()
    {
        await Storage.FlushAsync();
        Toasts.Show(Localization.T("toast.settings.forceSaved"), ToastLevel.Success);
    }

    private async Task ConfirmClear()
    {
        _confirmClear = false;
        await Storage.ClearAsync();
        Toasts.Show(Localization.T("toast.settings.cleared"), ToastLevel.Warning);
    }

    private async Task ExportShow(ShowData show)
    {
        var bytes = Bundle.ExportBundle(show);
        var stamp = DateTimeOffset.UtcNow.ToString("yyyyMMdd-HHmmss", CultureInfo.InvariantCulture);
        var fname = $"festivalrider-{Export.SanitizeFilename(show.Name)}-{stamp}.zip";
        await JS.InvokeVoidAsync("festivalRiderCsv.downloadBytes", fname, "application/zip", bytes);
        Toasts.Show(Localization.T("toast.shows.bundleExported", show.Name), ToastLevel.Success);
    }

    public void Dispose()
    {
        BandService.OnChange -= HandleChange;
        Localization.OnLocaleChanged -= HandleChange;
    }
}
