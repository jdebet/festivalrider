@page "/counter"
@implements IDisposable
@inject ILocalizationService Localization

<PageTitle>@Localization.T("page.counter.title")</PageTitle>

<h1>@Localization.T("page.counter.heading")</h1>

<p role="status">@Localization.T("page.counter.count", currentCount)</p>

<button class="btn btn-primary" @onclick="IncrementCount">@Localization.T("page.counter.clickMe")</button>

@code {
    private int currentCount = 0;

    protected override void OnInitialized()
    {
        Localization.OnLocaleChanged += HandleChange;
    }

    private void IncrementCount() {
        currentCount++;
    }

    private void HandleChange() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Localization.OnLocaleChanged -= HandleChange;
    }
}