@page "/running-order"
@using RoModel = FestivalRider.Models.RunningOrder
@implements IDisposable
@inject IBandService BandService
@inject ILocalizationService Localization
@inject IExportService Export
@inject IToastService Toasts
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@Localization.T("page.runningOrder.title")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="h4 m-0">@Localization.T("page.runningOrder.heading")</h1>
    <button class="btn btn-primary btn-sm" @onclick="AddRunningOrder">@Localization.T("page.runningOrder.addBtn")</button>
</div>

@if (_show.Stages.Count == 0)
{
    <div class="alert alert-warning py-2 small">@Localization.T("page.runningOrder.noStages")</div>
}
@if (BandService.Bands.Count == 0)
{
    <div class="alert alert-warning py-2 small">@Localization.T("page.runningOrder.noBands")</div>
}

@if (!BandService.RunningOrdersForActiveShow.Any())
{
    <div class="alert alert-info py-2 small">@Localization.T("page.runningOrder.empty", Localization.T("page.runningOrder.addBtn"))</div>
}
else
{
    @foreach (var order in BandService.RunningOrdersForActiveShow.OrderBy(o => o.ShowDayNumber))
    {
        <RiderSection Title="@TitleFor(order)">
            @{ var ro = order; }
            <div class="d-flex flex-wrap gap-2 align-items-end mb-2">
                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0">@Localization.T("page.runningOrder.dayLabel")</label>
                    <input type="number" min="1" max="@_show.ShowDayCount" class="form-control form-control-sm" style="width: 70px;"
                           value="@ro.ShowDayNumber"
                           @onchange="e => OnDayChanged(ro, e)" />
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0">@Localization.T("page.runningOrder.dateLabel")</label>
                    <input class="form-control form-control-sm" style="width: 130px;" readonly value="@FormatDate(ro)" />
                </div>
                <div class="ms-auto d-flex gap-1">
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ExportFull(ro)">@Localization.T("page.runningOrder.exportCsv")</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RequestDelete(ro.Id)">@Localization.T("page.runningOrder.deleteBtn")</button>
                </div>
            </div>

            @if (ro.Slots.Count == 0)
            {
                <div class="text-muted small mb-2">@Localization.T("page.runningOrder.noSlots")</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle fr-table-dense">
                        <thead>
                            <tr>
                                <th style="width: 32px"></th>
                                <th style="width: 18%">@Localization.T("page.runningOrder.col.stage")</th>
                                <th style="width: 12%">@Localization.T("page.runningOrder.col.start")</th>
                                <th style="width: 22%">@Localization.T("page.runningOrder.col.band")</th>
                                <th style="width: 10%">@Localization.T("page.runningOrder.col.setMin")</th>
                                <th style="width: 10%">@Localization.T("page.runningOrder.col.changeover")</th>
                                <th>@Localization.T("page.runningOrder.col.notes")</th>
                                <th style="width: 40px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < ro.Slots.Count; i++)
                            {
                                var idx = i;
                                <RunningOrderSlotRow OrderId="ro.Id"
                                                     Index="idx"
                                                     IsLast="@(idx == ro.Slots.Count - 1)"
                                                     Slot="ro.Slots[idx]"
                                                     Stages="_show.Stages"
                                                     Bands="BandService.Bands"
                                                     UnknownStageLabel="@Localization.T("page.runningOrder.unknownStage", ro.Slots[idx].StageId)"
                                                     UnknownBandLabel="@Localization.T("page.runningOrder.unknownBand")"
                                                     OnUpdate="args => UpdateSlot(ro, args.index, args.newSlot)"
                                                     OnRemove="idx2 => RemoveSlot(ro, idx2)"
                                                     OnMoveUp="idx2 => MoveSlot(ro, idx2, -1)"
                                                     OnMoveDown="idx2 => MoveSlot(ro, idx2, 1)" />
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="d-flex flex-wrap gap-2 align-items-end py-2">
                <button class="btn btn-sm btn-outline-primary" @onclick="() => AddSlot(ro)"
                        disabled="@(BandService.Bands.Count == 0 || _show.Stages.Count == 0)">@Localization.T("page.runningOrder.addSlotBtn")</button>

                @{
                    var stagesUsed = ro.Slots.Select(s => s.StageId).Distinct().ToList();
                    var bandsUsed = ro.Slots.Select(s => s.BandId).Distinct().ToList();
                }

                @if (stagesUsed.Count > 0)
                {
                    <div class="input-group input-group-sm" style="max-width: 280px;">
                        <span class="input-group-text">@Localization.T("page.runningOrder.stage")</span>
                        <select class="form-select" @bind="_byStageSelection[ro.Id]">
                            <option value="0">@Localization.T("page.runningOrder.pickStageDefault")</option>
                            @foreach (var sid in stagesUsed)
                            {
                                <option value="@sid">@(BandService.FindStage(sid)?.Name ?? $"Unknown #{sid}")</option>
                            }
                        </select>
                        <button class="btn btn-outline-secondary" @onclick="() => ExportByStage(ro)">@Localization.T("page.runningOrder.export")</button>
                        <button class="btn btn-outline-secondary" @onclick="() => PrintStage(ro)">@Localization.T("page.runningOrder.print")</button>
                    </div>
                }

                @if (bandsUsed.Count > 0)
                {
                    <div class="input-group input-group-sm" style="max-width: 300px;">
                        <span class="input-group-text">@Localization.T("page.runningOrder.band")</span>
                        <select class="form-select" @bind="_byBandSelection[ro.Id]">
                            <option value="@Guid.Empty">@Localization.T("page.runningOrder.pickBandDefault")</option>
                            @foreach (var bid in bandsUsed)
                            {
                                <option value="@bid">@(BandService.FindBand(bid)?.Name ?? Localization.T("page.runningOrder.unknownBand"))</option>
                            }
                        </select>
                        <button class="btn btn-outline-secondary" @onclick="() => ExportByBand(ro)">@Localization.T("page.runningOrder.export")</button>
                    </div>
                }

                <div class="input-group input-group-sm" style="max-width: 300px;">
                    <span class="input-group-text">@Localization.T("page.runningOrder.role")</span>
                    <select class="form-select" @bind="_byRoleSelection[ro.Id]">
                        @foreach (var r in Enum.GetValues<ContactRole>())
                        {
                            <option value="@r">@Localization.T($"enum.ContactRole.{r}")</option>
                        }
                    </select>
                    <button class="btn btn-outline-secondary" @onclick="() => PrintRole(ro)">@Localization.T("page.runningOrder.print")</button>
                </div>
            </div>
        </RiderSection>
    }
}

<ConfirmDialog Show="_pendingDeleteId.HasValue"
               Title="@Localization.T("confirm.deleteRunningOrder.title")"
               Message="@_deleteMessage"
               ConfirmLabel="@Localization.T("confirm.deleteRunningOrder.label")"
               OnConfirm="ConfirmDelete"
               OnCancel="() => _pendingDeleteId = null" />

@code {
    private ShowData _show = new();
    private Guid? _pendingDeleteId;
    private string _deleteMessage = string.Empty;

    private readonly Dictionary<Guid, int> _byStageSelection = new();
    private readonly Dictionary<Guid, Guid> _byBandSelection = new();
    private readonly Dictionary<Guid, ContactRole> _byRoleSelection = new();

    protected override void OnInitialized()
    {
        BandService.OnChange += HandleChange;
        Localization.OnLocaleChanged += HandleChange;
        Reload();
    }

    private void HandleChange()
    {
        Reload();
        InvokeAsync(StateHasChanged);
    }

    private void Reload()
    {
        _show = BandService.FindShow(BandService.ActiveShowId) ?? new ShowData();
        foreach (var o in BandService.RunningOrders)
        {
            _byStageSelection.TryAdd(o.Id, 0);
            _byBandSelection.TryAdd(o.Id, Guid.Empty);
            _byRoleSelection.TryAdd(o.Id, ContactRole.FOHEngineer);
        }
    }

    private string TitleFor(RoModel ro)
    {
        var date = FormatDate(ro);
        return string.IsNullOrEmpty(date)
            ? Localization.T("page.runningOrder.dayTitle.noDate", ro.ShowDayNumber, ro.Slots.Count)
            : Localization.T("page.runningOrder.dayTitle", ro.ShowDayNumber, date, ro.Slots.Count);
    }

    private string FormatDate(RoModel ro)
    {
        if (_show.DateOfOpening == default) return string.Empty;
        var date = _show.DateOfOpening.AddDays(ro.ShowDayNumber - 1);
        return date.ToString("ddd dd MMM yyyy");
    }

    private void AddRunningOrder()
    {
        var scoped = BandService.RunningOrdersForActiveShow.ToList();
        var nextDay = scoped.Count == 0
            ? 1
            : Math.Min(_show.ShowDayCount, scoped.Max(o => o.ShowDayNumber) + 1);
        var ro = new RoModel
        {
            ShowId = BandService.ActiveShowId,
            ShowDayNumber = Math.Max(1, nextDay),
        };
        BandService.AddRunningOrder(ro);
    }

    private void OnDayChanged(RoModel ro, ChangeEventArgs e)
    {
        var v = ParseInt(e.Value);
        if (v < 1) v = 1;
        if (v > _show.ShowDayCount) v = _show.ShowDayCount;
        ro.ShowDayNumber = v;
        BandService.UpdateRunningOrder(ro);
    }

    private void AddSlot(RoModel ro)
    {
        var stageId = _show.Stages.FirstOrDefault()?.Id ?? 0;
        var bandId = BandService.Bands.FirstOrDefault()?.Id ?? Guid.Empty;
        ro.Slots.Add(new RunningOrderSlot(bandId, stageId, new TimeOnly(12, 0), 45, 15, null));
        BandService.UpdateRunningOrder(ro);
    }

    private void RemoveSlot(RoModel ro, int idx)
    {
        if (idx < 0 || idx >= ro.Slots.Count) return;
        ro.Slots.RemoveAt(idx);
        BandService.UpdateRunningOrder(ro);
    }

    private void UpdateSlot(RoModel ro, int idx, RunningOrderSlot newSlot)
    {
        if (idx < 0 || idx >= ro.Slots.Count) return;
        ro.Slots[idx] = newSlot;
        BandService.UpdateRunningOrder(ro);
    }

    private void MoveSlot(RoModel ro, int idx, int delta)
    {
        var newIdx = idx + delta;
        if (newIdx < 0 || newIdx >= ro.Slots.Count) return;
        (ro.Slots[idx], ro.Slots[newIdx]) = (ro.Slots[newIdx], ro.Slots[idx]);
        BandService.UpdateRunningOrder(ro);
    }

    private void RequestDelete(Guid id)
    {
        var ro = BandService.FindRunningOrder(id);
        _pendingDeleteId = id;
        _deleteMessage = ro is null
            ? Localization.T("confirm.deleteRunningOrder.messageFallback")
            : Localization.T("confirm.deleteRunningOrder.message", ro.ShowDayNumber, ro.Slots.Count);
    }

    private void ConfirmDelete()
    {
        if (_pendingDeleteId is { } id)
        {
            BandService.DeleteRunningOrder(id);
            _byStageSelection.Remove(id);
            _byBandSelection.Remove(id);
            _byRoleSelection.Remove(id);
        }
        _pendingDeleteId = null;
    }

    private async Task ExportFull(RoModel ro)
    {
        var csv = Export.ExportRunningOrderCsv(ro);
        await Download(csv, $"running-order-day{ro.ShowDayNumber}.csv");
    }

    private async Task ExportByStage(RoModel ro)
    {
        if (!_byStageSelection.TryGetValue(ro.Id, out var sid) || sid <= 0)
        {
            Toasts.Show(Localization.T("toast.runningOrder.pickStage"), ToastLevel.Info);
            return;
        }
        var csv = Export.ExportRunningOrderByStageCsv(ro, sid);
        var stageName = BandService.FindStage(sid)?.Name ?? $"stage-{sid}";
        await Download(csv, $"running-order-day{ro.ShowDayNumber}-{Sanitize(stageName)}.csv");
    }

    private async Task ExportByBand(RoModel ro)
    {
        if (!_byBandSelection.TryGetValue(ro.Id, out var bid) || bid == Guid.Empty)
        {
            Toasts.Show(Localization.T("toast.runningOrder.pickBand"), ToastLevel.Info);
            return;
        }
        var csv = Export.ExportRunningOrderByBandCsv(ro, bid);
        var bandName = BandService.FindBand(bid)?.Name ?? "band";
        await Download(csv, $"running-order-day{ro.ShowDayNumber}-{Sanitize(bandName)}.csv");
    }

    private void PrintStage(RoModel ro)
    {
        if (!_byStageSelection.TryGetValue(ro.Id, out var sid) || sid <= 0)
        {
            Toasts.Show(Localization.T("toast.runningOrder.pickStage"), ToastLevel.Info);
            return;
        }
        Nav.NavigateTo($"print/stage/{ro.Id}:{sid}");
    }

    private void PrintRole(RoModel ro)
    {
        if (!_byRoleSelection.TryGetValue(ro.Id, out var role)) role = ContactRole.FOHEngineer;
        Nav.NavigateTo($"print/role/{ro.Id}:{role}");
    }

    private async Task Download(string text, string filename)
    {
        await JS.InvokeVoidAsync("festivalRiderCsv.downloadText", filename, "text/csv;charset=utf-8", text);
    }

    private static int ParseInt(object? value)
    {
        if (value is null) return 0;
        return int.TryParse(value.ToString(), System.Globalization.NumberStyles.Integer,
            System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0;
    }

    private static string Sanitize(string s)
    {
        var safe = new string((s ?? "untitled").Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray());
        return string.IsNullOrWhiteSpace(safe) ? "untitled" : safe.Trim('-');
    }

    public void Dispose()
    {
        BandService.OnChange -= HandleChange;
        Localization.OnLocaleChanged -= HandleChange;
    }
}
