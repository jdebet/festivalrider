@page "/"
@implements IDisposable
@inject IBandService BandService
@inject NavigationManager Nav

<PageTitle>Bands · FestivalRider</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Bands</h1>
    <button class="btn btn-primary" @onclick="AddBand">+ New band</button>
</div>

@if (BandService.Bands.Count == 0)
{
    <div class="alert alert-info">No bands yet. Click <strong>New band</strong> to add one.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var band in BandService.Bands)
        {
            <div class="col" @key="band.Id">
                <BandCard Band="band"
                          OnEdit="EditBand"
                          OnDelete="RequestDelete"
                          OnPrint="PrintBand" />
            </div>
        }
    </div>
}

<ConfirmDialog Show="_pendingDeleteId.HasValue"
               Title="Delete band"
               Message="@_deleteMessage"
               ConfirmLabel="Delete"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

@code {
    private Guid? _pendingDeleteId;
    private string _deleteMessage = string.Empty;

    protected override void OnInitialized()
    {
        BandService.OnChange += HandleChange;
    }

    private void HandleChange() => InvokeAsync(StateHasChanged);

    private void AddBand()
    {
        var band = new Band { Name = "New band" };
        BandService.AddBand(band);
        Nav.NavigateTo($"/band/{band.Id}");
    }

    private void EditBand(Guid id) => Nav.NavigateTo($"/band/{id}");

    private void PrintBand(Guid id) => Nav.NavigateTo($"/print/band/{id}");

    private void RequestDelete(Guid id)
    {
        var band = BandService.FindBand(id);
        _pendingDeleteId = id;
        _deleteMessage = $"Delete \"{band?.Name ?? "this band"}\"? This cannot be undone.";
    }

    private void ConfirmDelete()
    {
        if (_pendingDeleteId is { } id) BandService.DeleteBand(id);
        _pendingDeleteId = null;
    }

    private void CancelDelete() => _pendingDeleteId = null;

    public void Dispose()
    {
        BandService.OnChange -= HandleChange;
    }
}
