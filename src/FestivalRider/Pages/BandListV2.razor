@page "/"
@implements IDisposable
@inject IBandService BandService
@inject ILocalizationService Localization
@inject IToastService Toasts
@inject NavigationManager Nav

<PageTitle>@Localization.T("page.bandsV2.title")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="h4 m-0">@Localization.T("page.bands.heading")</h1>
    <button class="btn btn-primary btn-sm" @onclick="AddBand">@Localization.T("page.bands.addBand")</button>
</div>

<div class="d-flex flex-wrap gap-2 mb-2 align-items-center">
    <input type="text"
           class="form-control form-control-sm"
           style="max-width: 220px;"
           placeholder="@Localization.T(LocalizationKeys.Page.BandsV2.FilterPlaceholder)"
           @bind="_filter"
           @bind:event="oninput" />
    <select class="form-select form-select-sm" style="max-width: 160px;" @bind="_sortBy">
        <option value="">@Localization.T(LocalizationKeys.Page.BandsV2.Sort.Label)</option>
        <option value="nameAsc">@Localization.T(LocalizationKeys.Page.BandsV2.Sort.NameAsc)</option>
        <option value="nameDesc">@Localization.T(LocalizationKeys.Page.BandsV2.Sort.NameDesc)</option>
        <option value="travelParty">@Localization.T(LocalizationKeys.Page.BandsV2.Sort.TravelParty)</option>
        <option value="createdAt">@Localization.T(LocalizationKeys.Page.BandsV2.Sort.CreatedAt)</option>
        <option value="updatedAt">@Localization.T(LocalizationKeys.Page.BandsV2.Sort.UpdatedAt)</option>
    </select>
</div>

@if (FilteredBands.Count == 0)
{
    <p class="text-muted small">@Localization.T("page.bands.empty", Localization.T("page.bands.addBand"))</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover fr-table-dense align-middle">
            <thead>
                <tr>
                    <th>@Localization.T("field.name")</th>
                    <th class="text-center" style="width: 100px;">@Localization.T("section.contacts.title")</th>
                    <th class="text-center" style="width: 120px;">@Localization.T("section.travelParty.title")</th>
                    <th style="width: 140px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var band in FilteredBands)
                {
                    <BandTableRow Band="band"
                                  OnEdit="EditBand"
                                  OnDelete="RequestDelete"
                                  EditLabel="@Localization.T("page.bands.card.edit")"
                                  DeleteLabel="@Localization.T("page.bands.card.delete")" />
                }
            </tbody>
        </table>
    </div>
}

<ConfirmDialog Show="_pendingDeleteId.HasValue"
               Title="@Localization.T("confirm.deleteBand.title")"
               Message="@_deleteMessage"
               ConfirmLabel="@Localization.T("confirm.deleteBand.label")"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

@code {
    private Guid? _pendingDeleteId;
    private string _deleteMessage = string.Empty;
    private string _filter = string.Empty;
    private string _sortBy = string.Empty;

    private IReadOnlyList<Band> FilteredBands
    {
        get
        {
            var query = BandService.Bands.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_filter))
            {
                query = query.Where(b =>
                    b.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrWhiteSpace(b.Notes) && b.Notes.Contains(_filter, StringComparison.OrdinalIgnoreCase)));
            }

            query = _sortBy switch
            {
                "nameAsc" => query.OrderBy(b => b.Name),
                "nameDesc" => query.OrderByDescending(b => b.Name),
                "travelParty" => query.OrderByDescending(b => b.TravelParty.Members.Count).ThenBy(b => b.Name),
                "createdAt" => query.OrderByDescending(b => b.CreatedAt),
                "updatedAt" => query.OrderByDescending(b => b.UpdatedAt),
                _ => query.OrderBy(b => b.Name)
            };

            return query.ToList();
        }
    }

    protected override void OnInitialized()
    {
        BandService.OnChange += HandleChange;
        Localization.OnLocaleChanged += HandleChange;
    }

    private void HandleChange() => InvokeAsync(StateHasChanged);

    private void AddBand()
    {
        var band = new Band { Name = Localization.T("page.bands.newBandDefault") };
        BandService.AddBand(band);
        Toasts.Show(Localization.T(LocalizationKeys.Toast.Bands.Created, band.Name), ToastLevel.Success);
        Nav.NavigateTo($"/band/{band.Id}");
    }

    private void EditBand(Guid id) => Nav.NavigateTo($"/band/{id}");

    private void RequestDelete(Guid id)
    {
        var band = BandService.FindBand(id);
        _pendingDeleteId = id;
        _deleteMessage = Localization.T("confirm.deleteBand.message", band?.Name ?? string.Empty);
    }

    private void ConfirmDelete()
    {
        if (_pendingDeleteId is { } id)
        {
            BandService.DeleteBand(id);
            Toasts.Show(Localization.T(LocalizationKeys.Toast.Bands.Deleted), ToastLevel.Info);
        }
        _pendingDeleteId = null;
    }

    private void CancelDelete() => _pendingDeleteId = null;

    public void Dispose()
    {
        BandService.OnChange -= HandleChange;
        Localization.OnLocaleChanged -= HandleChange;
    }
}
