@page "/settings"
@using System.Globalization
@implements IDisposable
@inject IBandService BandService
@inject ILocalizationService Localization
@inject IStorageService Storage
@inject IExportService Export
@inject IBundleService Bundle
@inject IToastService Toasts
@inject IJSRuntime JS

<PageTitle>@Localization.T("page.settings.title")</PageTitle>

<h1 class="h3 mb-3">@Localization.T("page.settings.heading")</h1>

<RiderSection Title="@Localization.T("section.shows.title")">
    <p class="text-muted small">@Localization.T("page.settings.shows.description")</p>
    @if (BandService.Shows.Count == 0)
    {
        <div class="text-muted small mb-2">@Localization.T("page.settings.shows.noShows")</div>
    }
    else
    {
        <ul class="list-group mb-2">
            @foreach (var s in BandService.Shows)
            {
                var sid = s.Id;
                <li class="list-group-item d-flex justify-content-between align-items-center" @key="sid">
                    <div class="flex-grow-1 me-2">
                        <InputText class="form-control form-control-sm"
                                   @bind-Value="s.Name"
                                   @bind-Value:after="() => RenameShow(s)" />
                    </div>
                    <div class="btn-group btn-group-sm">
                        @if (BandService.ActiveShowId == sid)
                        {
                            <button type="button" class="btn btn-primary" disabled>@Localization.T("page.settings.shows.active")</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-primary"
                                    @onclick="() => SetActiveShow(sid)">@Localization.T("page.settings.shows.setActive")</button>
                        }
                        <button type="button" class="btn btn-outline-danger"
                                @onclick="() => RequestDeleteShow(sid)">@Localization.T("page.settings.shows.delete")</button>
                    </div>
                </li>
            }
        </ul>
    }
    <div class="row g-2 align-items-end">
        <div class="col-md-9">
            <input class="form-control" placeholder="@Localization.T("page.settings.shows.namePlaceholder")" @bind="_newShowName" />
        </div>
        <div class="col-md-3">
            <button type="button" class="btn btn-outline-primary w-100" @onclick="AddShow">@Localization.T("page.settings.shows.addBtn")</button>
        </div>
    </div>
</RiderSection>

<RiderSection Title="@Localization.T("section.showDetails.title")">
    <EditForm Model="_show" OnValidSubmit="SaveShow">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <label class="form-label">@Localization.T("field.name")</label>
                <InputText class="form-control" @bind-Value="_show.Name" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localization.T("page.settings.showDetails.address")</label>
                <InputText class="form-control" @bind-Value="_show.Address" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@Localization.T("page.settings.showDetails.dateOfOpening")</label>
                <InputDate class="form-control" @bind-Value="_dateOfOpening" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@Localization.T("page.settings.showDetails.showDayCount")</label>
                <InputNumber class="form-control" @bind-Value="_show.ShowDayCount" />
            </div>
        </div>

        <h6>@Localization.T("page.settings.showDetails.stages")</h6>
        @if (_show.Stages.Count == 0)
        {
            <div class="text-muted small mb-2">@Localization.T("page.settings.showDetails.noStages")</div>
        }
        else
        {
            @for (var i = 0; i < _show.Stages.Count; i++)
            {
                var idx = i;
                var s = _show.Stages[idx];
                <div class="row g-2 align-items-end mb-2" @key="s.Id">
                    <div class="col-md-1"><span class="badge bg-secondary">#@s.Id</span></div>
                    <div class="col-md-8">
                        <InputText class="form-control" @bind-Value="s.Name" />
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-outline-danger w-100"
                                @onclick="() => RequestDeleteStage(s.Id)">@Localization.T("page.settings.shows.delete")</button>
                    </div>
                </div>
            }
        }
        <div class="row g-2 align-items-end mb-2">
            <div class="col-md-9">
                <input class="form-control" placeholder="@Localization.T("page.settings.showDetails.newStagePlaceholder")" @bind="_newStageName" />
            </div>
            <div class="col-md-3">
                <button type="button" class="btn btn-outline-primary w-100" @onclick="AddStage">@Localization.T("page.settings.showDetails.addStageBtn")</button>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">@Localization.T("page.settings.showDetails.saveBtn")</button>
    </EditForm>
</RiderSection>

<RiderSection Title="@Localization.T("section.showCsv.title")">
    <p class="text-muted small">@Localization.T("page.settings.showCsv.description")</p>
    <div class="d-flex flex-wrap gap-2 mb-2">
        <button type="button" class="btn btn-outline-primary" @onclick="ExportShowCsv">@Localization.T("page.settings.showCsv.exportBtn")</button>
        <label class="btn btn-outline-secondary mb-0">
            @Localization.T("page.settings.showCsv.importBtn")
            <InputFile OnChange="ImportShowCsv" accept=".csv" class="d-none" />
        </label>
    </div>
</RiderSection>

<RiderSection Title="@Localization.T("section.bandsCsv.title")">
    <p class="text-muted small">@Localization.T("page.settings.bandsCsv.description")</p>
    <div class="d-flex flex-wrap gap-2 mb-3">
        <label class="btn btn-outline-secondary mb-0">
            @Localization.T("page.settings.bandsCsv.importBtn")
            <InputFile OnChange="ImportBandCsv" accept=".csv" class="d-none" />
        </label>
    </div>
    @if (BandService.Bands.Count == 0)
    {
        <div class="text-muted small">@Localization.T("page.settings.bandsCsv.noBands")</div>
    }
    else
    {
        <ul class="list-group">
            @foreach (var band in BandService.Bands)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center" @key="band.Id">
                    <span>@band.Name</span>
                    <button type="button" class="btn btn-sm btn-outline-primary"
                            @onclick="() => ExportBandCsv(band)">@Localization.T("page.settings.bandsCsv.exportBtn")</button>
                </li>
            }
        </ul>
    }
</RiderSection>

<RiderSection Title="@Localization.T("section.bundle.title")">
    <p class="text-muted small">@Localization.T("page.settings.bundle.description")</p>
    <div class="mb-2">
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" id="bundleModeReplace"
                   checked="@(_bundleImportMode == BundleImportMode.Replace)"
                   @onchange="() => _bundleImportMode = BundleImportMode.Replace" />
            <label class="form-check-label" for="bundleModeReplace">@Localization.T("page.settings.bundle.replace")</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" id="bundleModeMerge"
                   checked="@(_bundleImportMode == BundleImportMode.Merge)"
                   @onchange="() => _bundleImportMode = BundleImportMode.Merge" />
            <label class="form-check-label" for="bundleModeMerge">@Localization.T("page.settings.bundle.merge")</label>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mb-2">
        <button type="button" class="btn btn-outline-primary" @onclick="ExportBundle">@Localization.T("page.settings.bundle.exportBtn")</button>
        <label class="btn btn-outline-secondary mb-0">
            @Localization.T("page.settings.bundle.importBtn")
            <InputFile OnChange="StageBundleImport" accept=".zip" class="d-none" />
        </label>
    </div>
</RiderSection>

<ConfirmDialog Show="_pendingBundle is not null"
               Title="@_bundleConfirmTitle"
               Message="@_bundleConfirmMessage"
               ConfirmLabel="@_bundleConfirmLabel"
               OnConfirm="ConfirmBundleImport"
               OnCancel="() => _pendingBundle = null" />

<RiderSection Title="@Localization.T("section.storage.title")">
    <p class="text-muted small">
        Schema version: <strong>@_snapshot.SchemaVersion</strong>
        · Bands: <strong>@_snapshot.Bands.Count</strong>
        · Running orders: <strong>@_snapshot.RunningOrders.Count</strong>
    </p>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-primary" @onclick="ForceSave">@Localization.T("page.settings.storage.forceSave")</button>
        <button type="button" class="btn btn-outline-danger" @onclick="() => _confirmClear = true">@Localization.T("page.settings.storage.clearAll")</button>
    </div>
</RiderSection>

<ConfirmDialog Show="_confirmClear"
               Title="@Localization.T("confirm.clearData.title")"
               Message="@Localization.T("confirm.clearData.message")"
               ConfirmLabel="@Localization.T("confirm.clearData.label")"
               OnConfirm="ConfirmClear"
               OnCancel="() => _confirmClear = false" />

<ConfirmDialog Show="_pendingDeleteStageId.HasValue"
               Title="@Localization.T("confirm.deleteStage.title")"
               Message="@_deleteStageMessage"
               ConfirmLabel="@Localization.T("confirm.deleteStage.label")"
               OnConfirm="ConfirmDeleteStage"
               OnCancel="() => _pendingDeleteStageId = null" />

<ConfirmDialog Show="_pendingDeleteShowId.HasValue"
               Title="@Localization.T("confirm.deleteShow.title")"
               Message="@_deleteShowMessage"
               ConfirmLabel="@Localization.T("confirm.deleteShow.label")"
               OnConfirm="ConfirmDeleteShow"
               OnCancel="() => _pendingDeleteShowId = null" />

@code {
    private ShowData _show = new();
    private DateTime _dateOfOpening = DateTime.Today;
    private string _newStageName = string.Empty;
    private string _newShowName = string.Empty;
    private bool _confirmClear;
    private int? _pendingDeleteStageId;
    private string _deleteStageMessage = string.Empty;
    private Guid? _pendingDeleteShowId;
    private string _deleteShowMessage = string.Empty;
    private AppState _snapshot = new();
    private BundleImportResult? _pendingBundle;
    private BundleImportMode _bundleImportMode = BundleImportMode.Replace;
    private BundleImportMode _pendingBundleMode = BundleImportMode.Replace;
    private string _bundleConfirmTitle = string.Empty;
    private string _bundleConfirmMessage = string.Empty;
    private string _bundleConfirmLabel = string.Empty;

    protected override void OnInitialized()
    {
        BandService.OnChange += HandleChange;
        Localization.OnLocaleChanged += HandleChange;
        Reload();
    }

    private void HandleChange()
    {
        Reload();
        InvokeAsync(StateHasChanged);
    }

    private void Reload()
    {
        _snapshot = BandService.Snapshot();
        _show = BandService.FindShow(BandService.ActiveShowId) ?? _snapshot.Shows.FirstOrDefault() ?? new ShowData();
        _dateOfOpening = _show.DateOfOpening == default
            ? DateTime.Today
            : _show.DateOfOpening.ToDateTime(TimeOnly.MinValue);
    }

    private async Task SaveShow()
    {
        _show.DateOfOpening = DateOnly.FromDateTime(_dateOfOpening);
        await BandService.UpdateShow(_show);
        Toasts.Show(Localization.T("toast.settings.showDetailsSaved"), ToastLevel.Success);
    }

    private void AddStage()
    {
        var name = _newStageName.Trim();
        if (string.IsNullOrEmpty(name)) return;
        var id = BandService.AddStage(name);
        _newStageName = string.Empty;
        Toasts.Show(Localization.T("toast.settings.stageAdded", name, id), ToastLevel.Success);
    }

    private void RequestDeleteStage(int id)
    {
        var stage = BandService.FindStage(id);
        _pendingDeleteStageId = id;
        _deleteStageMessage = Localization.T("confirm.deleteStage.message", stage?.Name ?? id.ToString());
    }

    private void ConfirmDeleteStage()
    {
        if (_pendingDeleteStageId is { } id)
        {
            BandService.DeleteStage(id);
            Toasts.Show(Localization.T("toast.settings.stageDeleted"), ToastLevel.Info);
        }
        _pendingDeleteStageId = null;
    }

    private void AddShow()
    {
        var name = _newShowName.Trim();
        if (string.IsNullOrEmpty(name)) return;
        var id = BandService.AddShow(name);
        _newShowName = string.Empty;
        Toasts.Show(Localization.T("toast.settings.showAdded", name), ToastLevel.Success);
        _ = BandService.SetActiveShow(id);
    }

    private async Task SetActiveShow(Guid id)
    {
        await BandService.SetActiveShow(id);
    }

    private async Task RenameShow(ShowData show)
    {
        await BandService.UpdateShow(show);
    }

    private void RequestDeleteShow(Guid id)
    {
        var show = BandService.FindShow(id);
        var roCount = BandService.RunningOrders.Count(o => o.ShowId == id);
        _pendingDeleteShowId = id;
        _deleteShowMessage = roCount == 0
            ? Localization.T("confirm.deleteShow.message", show?.Name ?? id.ToString())
            : Localization.T("confirm.deleteShow.messageWithRo", show?.Name ?? id.ToString(), roCount);
    }

    private async Task ConfirmDeleteShow()
    {
        if (_pendingDeleteShowId is { } id)
        {
            // Running orders tied to this show would otherwise orphan; remove them first.
            foreach (var ro in BandService.RunningOrders.Where(o => o.ShowId == id).Select(o => o.Id).ToList())
                BandService.DeleteRunningOrder(ro);
            await BandService.DeleteShow(id);
            Toasts.Show(Localization.T("toast.settings.showDeleted"), ToastLevel.Info);
        }
        _pendingDeleteShowId = null;
    }

    private async Task ForceSave()
    {
        await Storage.FlushAsync();
        Toasts.Show(Localization.T("toast.settings.forceSaved"), ToastLevel.Success);
    }

    private async Task ConfirmClear()
    {
        _confirmClear = false;
        await Storage.ClearAsync();
        Toasts.Show(Localization.T("toast.settings.cleared"), ToastLevel.Warning);
    }

    private async Task ExportShowCsv()
    {
        var csv = Export.ExportShowCsv(_show);
        var fname = $"show-{Sanitize(_show.Name)}.csv";
        await Download(csv, fname);
    }

    private async Task ExportBandCsv(Band band)
    {
        var csv = Export.ExportBandCsv(band);
        var fname = $"band-{Sanitize(band.Name)}.csv";
        await Download(csv, fname);
    }

    private async Task ImportShowCsv(InputFileChangeEventArgs e)
    {
        var csv = await ReadAllAsync(e.File);
        if (csv is null) return;
        try
        {
            var show = Export.ImportShowCsv(csv);
            // Pin the imported show to the currently active ShowId so stage references stay consistent.
            show.Id = BandService.ActiveShowId;
            await BandService.UpdateShow(show);
            Toasts.Show(Localization.T("toast.settings.showImported", show.Name, show.Stages.Count), ToastLevel.Success);
        }
        catch (Exception ex)
        {
            Toasts.Show(Localization.T("toast.settings.importFailed", ex.Message), ToastLevel.Error);
        }
    }

    private async Task ImportBandCsv(InputFileChangeEventArgs e)
    {
        var csv = await ReadAllAsync(e.File);
        if (csv is null) return;
        try
        {
            var band = Export.ImportBandCsv(csv);
            var existing = BandService.FindBand(band.Id);
            if (existing is null)
            {
                BandService.AddBand(band);
                Toasts.Show(Localization.T("toast.settings.bandImported", band.Name), ToastLevel.Success);
            }
            else
            {
                BandService.DeleteBand(existing.Id);
                BandService.AddBand(band);
                Toasts.Show(Localization.T("toast.settings.bandReplaced", band.Name), ToastLevel.Success);
            }
        }
        catch (Exception ex)
        {
            Toasts.Show(Localization.T("toast.settings.importFailed", ex.Message), ToastLevel.Error);
        }
    }

    private static async Task<string?> ReadAllAsync(IBrowserFile file)
    {
        const long maxSize = 5 * 1024 * 1024;
        try
        {
            await using var s = file.OpenReadStream(maxSize);
            using var reader = new StreamReader(s);
            return await reader.ReadToEndAsync();
        }
        catch
        {
            return null;
        }
    }

    private async Task Download(string text, string filename)
    {
        await JS.InvokeVoidAsync("festivalRiderCsv.downloadText", filename, "text/csv;charset=utf-8", text);
    }

    private async Task ExportBundle()
    {
        var bytes = Bundle.ExportBundle(BandService.Snapshot());
        var stamp = DateTimeOffset.UtcNow.ToString("yyyyMMdd-HHmmss", CultureInfo.InvariantCulture);
        var fname = $"festivalrider-{Sanitize(_show.Name)}-{stamp}.zip";
        await JS.InvokeVoidAsync("festivalRiderCsv.downloadBytes", fname, "application/zip", bytes);
        Toasts.Show(Localization.T("toast.settings.bundleExported", bytes.Length / 1024), ToastLevel.Success);
    }

    private async Task StageBundleImport(InputFileChangeEventArgs e)
    {
        const long maxSize = 20L * 1024 * 1024;
        var mode = _bundleImportMode;
        BundleImportResult result;
        try
        {
            await using var s = e.File.OpenReadStream(maxSize);
            using var ms = new MemoryStream();
            await s.CopyToAsync(ms);
            ms.Position = 0;
            var current = mode == BundleImportMode.Merge ? BandService.Snapshot() : null;
            result = Bundle.ImportBundle(ms, mode, current);
        }
        catch (IOException)
        {
            Toasts.Show(Localization.T("toast.settings.bundleSizeExceeded", maxSize / (1024 * 1024)), ToastLevel.Error);
            return;
        }
        catch (Exception ex)
        {
            Toasts.Show(Localization.T("toast.settings.bundleReadFailed", ex.Message), ToastLevel.Error);
            return;
        }

        if (result.Error is not null || result.State is null)
        {
            Toasts.Show(Localization.T("toast.settings.bundleRejected", result.Error), ToastLevel.Error);
            return;
        }

        _pendingBundle = result;
        _pendingBundleMode = mode;
        if (mode == BundleImportMode.Merge)
        {
            _bundleConfirmTitle = Localization.T("confirm.bundleMerge.title");
            _bundleConfirmLabel = Localization.T("confirm.bundleMerge.label");
            _bundleConfirmMessage = Localization.T("confirm.bundleMerge.message", result.BandCount, result.RunningOrderCount);
        }
        else
        {
            _bundleConfirmTitle = Localization.T("confirm.bundleReplace.title");
            _bundleConfirmLabel = Localization.T("confirm.bundleReplace.label");
            _bundleConfirmMessage = Localization.T("confirm.bundleReplace.message", result.BandCount, result.RunningOrderCount);
        }
    }

    private void ConfirmBundleImport()
    {
        var result = _pendingBundle;
        var mode = _pendingBundleMode;
        _pendingBundle = null;
        if (result?.State is null) return;
        BandService.ReplaceState(result.State);

        string summary;
        if (mode == BundleImportMode.Merge && result.Merge is { } m)
        {
            summary = Localization.T("toast.settings.bundleMergeApplied", m.BandsAdded, m.BandsUpdated, m.BandsSkipped, m.RunningOrdersAdded, m.RunningOrdersUpdated, m.RunningOrdersSkipped);
        }
        else
        {
            summary = Localization.T("toast.settings.bundleImported", result.BandCount, result.RunningOrderCount);
        }

        if (result.Warnings.Count == 0)
        {
            Toasts.Show(summary, ToastLevel.Success);
        }
        else
        {
            var head = string.Join(" ", result.Warnings.Take(2));
            Toasts.Show($"{summary} {head}", ToastLevel.Warning);
        }
    }

    private static string Sanitize(string s)
    {
        var safe = new string((s ?? "untitled").Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray());
        return string.IsNullOrWhiteSpace(safe) ? "untitled" : safe.Trim('-');
    }

    public void Dispose()
    {
        BandService.OnChange -= HandleChange;
        Localization.OnLocaleChanged -= HandleChange;
    }
}
