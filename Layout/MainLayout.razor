@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IStorageService Storage
@inject IToastService Toasts

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <MultiTabBanner Show="Storage.AnotherTabActive" />
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<ToastContainer Toasts="Toasts.Active" OnDismiss="Toasts.Dismiss" />

@code {
    protected override void OnInitialized()
    {
        Storage.OnAnotherTabChanged += HandleChange;
        Toasts.OnChange += HandleChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Storage.EnsureLoadedAsync();
        }
    }

    private void HandleChange() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Storage.OnAnotherTabChanged -= HandleChange;
        Toasts.OnChange -= HandleChange;
        await Storage.FlushAsync();
    }
}