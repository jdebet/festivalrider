<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.14"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.14" PrivateAssets="all"/>
        <PackageReference Include="CsvHelper" Version="33.0.1"/>
    </ItemGroup>

    <ItemGroup>
        <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="FestivalRider.Tests\**\*.cs" />
    </ItemGroup>

    <!--
        Rewrites <base href="/"> in the published index.html and 404.html when
        $(BlazorWebAssemblyBaseHref) is supplied (e.g. CI: -p:BlazorWebAssemblyBaseHref=/FestivalRider/).
        Local dev publishes leave the base href untouched.
    -->
    <Target Name="RewriteBlazorWebAssemblyBaseHref" AfterTargets="Publish" Condition="'$(BlazorWebAssemblyBaseHref)' != ''">
        <ItemGroup>
            <_BaseHrefRewriteTargets Include="$(PublishDir)wwwroot\index.html" Condition="Exists('$(PublishDir)wwwroot\index.html')"/>
            <_BaseHrefRewriteTargets Include="$(PublishDir)wwwroot\404.html" Condition="Exists('$(PublishDir)wwwroot\404.html')"/>
        </ItemGroup>
        <WriteLinesToFile
            File="%(_BaseHrefRewriteTargets.Identity)"
            Lines="$([System.IO.File]::ReadAllText('%(_BaseHrefRewriteTargets.Identity)').Replace('&lt;base href=&quot;/&quot; /&gt;', '&lt;base href=&quot;$(BlazorWebAssemblyBaseHref)&quot; /&gt;'))"
            Overwrite="true"
            Encoding="UTF-8"/>
        <Message Importance="high" Text="Rewrote &lt;base href&gt; to '$(BlazorWebAssemblyBaseHref)' in %(_BaseHrefRewriteTargets.Identity)"/>
    </Target>

</Project>
