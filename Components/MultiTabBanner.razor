@if (Show)
{
    <div class="alert alert-warning mb-0 rounded-0 border-0 text-center" role="alert">
        <strong>Another tab is editing this app.</strong>
        Editing is disabled here to avoid conflicting writes. Close the other tab, then reload.
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
}
